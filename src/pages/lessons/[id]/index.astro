---
import LessonShell from "../../../components/LessonShell.astro";
import LectureVideo from "../../../components/LectureVideo.astro";
import EpisodeCard from "../../../components/EpisodeCard.astro";
import Icon from "../../../components/Icon.astro";
import { getLessons, readNote, readSlides, type Lesson } from "../../../lib/content";
import { renderMarkdown } from "../../../lib/markdown";
import { NOTE_LEVELS, lessonPath, withBase } from "../../../lib/routes";
import { knownIds } from "../../../lib/content";
import { NOTES_GITHUB } from "../../../lib/links";

export function getStaticPaths() {
  return getLessons().map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}
const { lesson } = Astro.props as { lesson: Lesson };
const base = import.meta.env.BASE_URL;

// Reading time per notes level and the lesson's main topics (from the most complete notes available).
const stats: Record<string, { minutes: number }> = {};
let topics: string[] = [];
for (const { level } of NOTE_LEVELS) {
  const src = readNote(lesson.id, level);
  if (!src) continue;
  const doc = await renderMarkdown(src, { kind: level, sid: lesson.id, base, known: knownIds() });
  stats[level] = { minutes: Math.max(1, Math.round(doc.words / 220)) };
  const h2 = doc.toc.filter((t) => t.depth === 2).map((t) => t.text.replace(/^\d+(\.\d+)*\.?\s+/, ""));
  if (h2.length >= topics.length) topics = h2;
}
topics = topics.filter((t) => !/terminolog|interview question|must remember|next session|sources|recap|checklist|glossary|references|overview/i.test(t)).slice(0, 10);
const slides = readSlides(lesson.id);
---
<LessonShell lesson={lesson} view="lecture" viewLabel="Lecture">
  <div class="lesson-grid">
    <div data-pagefind-body data-pagefind-filter="type:Lesson" data-pagefind-meta={`lesson:${lesson.label}`}>
      <span class="visually-hidden" data-pagefind-meta="title" data-pagefind-ignore>{lesson.label} — {lesson.title}</span>
      <LectureVideo lecture={lesson.lecture} title={`${lesson.label} — ${lesson.title}`} />

      {topics.length > 0 && (
        <section style="margin-top:1.75rem" aria-labelledby="topics-h">
          <h2 id="topics-h" style="font-size:1.1rem;margin:0 0 .5rem">What this lesson covers</h2>
          <ul style="margin:0;padding-left:1.25rem;columns:2 16rem;column-gap:2rem">
            {topics.map((t) => <li style="break-inside:avoid;margin:.15rem 0">{t}</li>)}
          </ul>
        </section>
      )}

      <section style="margin-top:1.75rem" aria-labelledby="pod-h" data-pagefind-ignore>
        <h2 id="pod-h" style="font-size:1.1rem;margin:0 0 .5rem">Summary podcast</h2>
        {lesson.podcasts.length ? (
          <ul class="episode-list">{lesson.podcasts.map((ep) => <EpisodeCard episode={ep} />)}</ul>
        ) : (
          <div class="notice"><Icon name="info" /><div><strong>No summary podcast for this lesson yet</strong><p>Add one in config/media.json and it will be listed here.</p></div></div>
        )}
      </section>
    </div>

    <aside class="card" aria-labelledby="res-h" style="align-self:start">
      <h2 id="res-h" class="card-title"><Icon name="notes" /> Study resources</h2>
      <ul class="resource-list">
        {NOTE_LEVELS.map(({ level, label, blurb }) => (
          <li>
            {lesson.notes[level] ? (
              <a href={withBase(base, lessonPath(lesson.id, level))}>
                <Icon name={level === "simple" ? "text" : level === "detailed" ? "notes" : "file"} />
                <span>{label}<small>{blurb} · {stats[level]?.minutes} min read</small></span>
              </a>
            ) : (
              <span class="off"><Icon name="file" /><span>{label}<small>Not available for this lesson</small></span></span>
            )}
          </li>
        ))}
        <li>
          {slides && slides.slides.length ? (
            <a href={withBase(base, lessonPath(lesson.id, "slides"))}><Icon name="slides" /><span>Slides<small>{slides.slides.length} screens from the class</small></span></a>
          ) : (
            <span class="off"><Icon name="slides" /><span>Slides<small>Not available for this lesson</small></span></span>
          )}
        </li>
        {lesson.transcripts.map((t) => (
          <li><a href={t.url} target="_blank" rel="noopener noreferrer"><Icon name="external" /><span>{t.label}<small>Text of the class, on GitHub</small></span></a></li>
        ))}
        <li><a href={`${NOTES_GITHUB}/blob/main/${lesson.id}.md`} target="_blank" rel="noopener noreferrer"><Icon name="github" /><span>Source notes<small>green-c-mule-notes on GitHub</small></span></a></li>
      </ul>
    </aside>
  </div>
</LessonShell>
