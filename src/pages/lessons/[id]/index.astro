---
import LessonShell from "../../../components/LessonShell.astro";
import LectureVideo from "../../../components/LectureVideo.astro";
import EpisodeCard from "../../../components/EpisodeCard.astro";
import Icon from "../../../components/Icon.astro";
import { getLessons, readNote, readSlides, type Lesson } from "../../../lib/content";
import { renderMarkdown } from "../../../lib/markdown";
import { NOTE_LEVELS, lessonHasView, lessonPath, withBase } from "../../../lib/routes";
import { knownIds } from "../../../lib/content";
import { NOTES_GITHUB } from "../../../lib/links";
import { cardsFor } from "../../../lib/cards";

export function getStaticPaths() {
  return getLessons().map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}
const { lesson } = Astro.props as { lesson: Lesson };
const base = import.meta.env.BASE_URL;

// Reading time per notes level and the lesson's main topics (from the most complete notes available).
const stats: Record<string, { minutes: number }> = {};
let topics: string[] = [];
for (const { level } of NOTE_LEVELS) {
  const src = readNote(lesson.id, level);
  if (!src) continue;
  const doc = await renderMarkdown(src, { kind: level, sid: lesson.id, base, known: knownIds() });
  stats[level] = { minutes: Math.max(1, Math.round(doc.words / 220)) };
  const h2 = doc.toc.filter((t) => t.depth === 2).map((t) => t.text.replace(/^\d+(\.\d+)*\.?\s+/, ""));
  if (h2.length >= topics.length) topics = h2;
}
topics = topics.filter((t) => !/terminolog|interview question|must remember|next session|sources|recap|checklist|glossary|references|overview/i.test(t)).slice(0, 10);
const slides = readSlides(lesson.id);
const playable = lesson.podcasts.filter((ep) => ep.audioUrl || ep.videoUrl);
// "Check yourself": the first few interview questions of this lesson's notes, answers copied unchanged
const allChecks = cardsFor(lesson.id);
const checks = await Promise.all(allChecks.slice(0, 3).map(async (c) => ({
  q: (await renderMarkdown(c.question, { kind: "super", sid: lesson.id, base, known: knownIds() })).html.replace(/^<p>|<\/p>\s*$/g, ""),
  a: (await renderMarkdown(c.answer, { kind: "super", sid: lesson.id, base, known: knownIds() })).html,
})));
---
<LessonShell lesson={lesson} view="lecture" viewLabel="Lecture">
  <div class="lesson-grid">
    <div class="grid" data-pagefind-body data-pagefind-filter="type:Lesson" data-pagefind-meta={`lesson:${lesson.label}`}>
      <span class="visually-hidden" data-pagefind-meta="title" data-pagefind-ignore>{lesson.label} — {lesson.title}</span>
      <div class="card">
        <LectureVideo lecture={lesson.lecture} title={`${lesson.label} — ${lesson.title}`} playerHref={lesson.lecture?.youtubeId ? withBase(base, `videos/${lesson.id}/`) : undefined} />
      </div>

      {topics.length > 0 && (
        <section class="card takeaways" aria-labelledby="topics-h">
          <span class="pill pill--blue">Learning objectives</span>
          <h2 id="topics-h" style="font-size:1.15rem;margin:.75rem 0 0">After this lesson you should be able to explain</h2>
          <ul>
            {topics.map((t) => <li><Icon name="check" />{t}</li>)}
          </ul>
        </section>
      )}

      {checks.length > 0 && (
        <section class="card" aria-labelledby="chk-h" data-pagefind-ignore>
          <div class="section-head" style="margin-top:0">
            <div><h2 id="chk-h" style="font-size:1.15rem">Check yourself</h2><p>Answer out loud first, then open the answer. From the interview questions in the notes.</p></div>
            <a class="btn btn--sm" href={withBase(base, lessonPath(lesson.id, "revise")) + "#rv-selftest"}>All {allChecks.length} questions</a>
          </div>
          <ol class="qa-list">
            {checks.map((c, i) => (
              <li>
                <details class="qa">
                  <summary><span class="qa__n">Q{i + 1}</span><span class="qa__q" set:html={c.q} /></summary>
                  <div class="prose qa__a" set:html={c.a} />
                </details>
              </li>
            ))}
          </ol>
          <p class="small muted" style="margin:.75rem 0 0">These questions are also flashcards: <a href={withBase(base, "revise/#fc-h")}>review them on a schedule</a>.</p>
        </section>
      )}

      <section class="card" aria-labelledby="pod-h" data-pagefind-ignore>
        <h2 id="pod-h" class="card-title"><Icon name="podcast" /> Summary podcast</h2>
        {playable.length ? (
          <ul class="episode-list episode-list--single">{playable.map((ep) => <EpisodeCard episode={ep} />)}</ul>
        ) : (
          <div class="notice"><Icon name="info" /><div><strong>No summary podcast for this lesson yet</strong><p>The video and audio summary will appear here once its links are added to config/media.json.</p></div></div>
        )}
      </section>
    </div>

    <aside class="card" aria-labelledby="res-h" style="align-self:start">
      <h2 id="res-h" class="card-title"><Icon name="notes" /> Study resources</h2>
      <ul class="resource-list">
        {NOTE_LEVELS.map(({ level, label, blurb }) => (
          <li>
            {lesson.notes[level] ? (
              <a href={withBase(base, lessonPath(lesson.id, level))}>
                <Icon name={level === "simple" ? "text" : level === "detailed" ? "notes" : "file"} />
                <span>{label}<small>{blurb} · {stats[level]?.minutes} min read</small></span>
              </a>
            ) : (
              <span class="off"><Icon name="file" /><span>{label}<small>Not available for this lesson</small></span></span>
            )}
          </li>
        ))}
        <li>
          {slides && slides.slides.length ? (
            <a href={withBase(base, lessonPath(lesson.id, "slides"))}><Icon name="slides" /><span>Slides<small>{slides.slides.length} screens from the class</small></span></a>
          ) : (
            <span class="off"><Icon name="slides" /><span>Slides<small>Not available for this lesson</small></span></span>
          )}
        </li>
        {lesson.transcripts.map((t) => (
          <li><a href={t.url} target="_blank" rel="noopener noreferrer"><Icon name="external" /><span>{t.label}<small>Text of the class, on GitHub</small></span></a></li>
        ))}
        <li><a href={`${NOTES_GITHUB}/blob/main/${lesson.id}.md`} target="_blank" rel="noopener noreferrer"><Icon name="github" /><span>Source notes<small>green-c-mule-notes on GitHub</small></span></a></li>
      </ul>
      {lessonHasView(lesson, "revise") && <a class="btn btn--soft" style="width:100%;margin-top:1rem" href={withBase(base, lessonPath(lesson.id, "revise"))}>Practice this lesson →</a>}
    </aside>
  </div>
</LessonShell>
