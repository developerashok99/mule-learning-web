---
import LessonShell from "../../../components/LessonShell.astro";
import Icon from "../../../components/Icon.astro";
import { getLessons, knownIds, readSlides, type Lesson } from "../../../lib/content";
import { renderMarkdown } from "../../../lib/markdown";
import { rewriteLink } from "../../../lib/links";
import { APP_BUILD, WEBSITE, withBase } from "../../../lib/routes";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  return getLessons()
    .filter((l) => l.slides > 0)
    .map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}
const { lesson } = Astro.props as { lesson: Lesson };
const base = import.meta.env.BASE_URL;
const data = readSlides(lesson.id)!;
const intro = data.intro ? await renderMarkdown(data.intro, { kind: "slides", sid: lesson.id, base, known: knownIds() }) : null;
const src = (file: string) => rewriteLink(file, "slides", lesson.id, base).href;
// the full-size image: in the app it comes from the website (not bundled), with the thumbnail as the offline fallback
const full = (file: string) => (APP_BUILD ? `${WEBSITE}notes-assets/slides/${lesson.id}/${encodeURIComponent(file)}` : src(file));
// 560px WebP thumbnails made by the sync script; fall back to the original if one is missing
const thumbFile = (file: string) => path.join(process.cwd(), "public/notes-assets/thumbs", lesson.id, file.replace(/\.[^.]+$/, ".webp"));
const thumb = (file: string) => (fs.existsSync(thumbFile(file)) ? withBase(base, `notes-assets/thumbs/${lesson.id}/${encodeURIComponent(file.replace(/\.[^.]+$/, ".webp"))}`) : src(file));
---
<LessonShell lesson={lesson} view="slides" viewLabel="Slides">
  <div data-pagefind-body data-pagefind-filter="type:Slides" data-pagefind-meta={`lesson:${lesson.label}`}>
    <h1 class="visually-hidden">{lesson.label} slides — {lesson.title}</h1>
    <span class="visually-hidden" data-pagefind-meta="title" data-pagefind-ignore>{lesson.label} · Slides — {lesson.title}</span>
    <div class="doc-tools"><span><span class="badge badge--accent">Slides</span> · {data.slides.length} screens captured from the class recording · select one to enlarge</span></div>
    {intro && <div class="prose" style="margin-bottom:1.25rem" set:html={intro.html} />}
    <ul class="slides-grid">
      {data.slides.map((s, i) => (
        <li>
          <figure class="slide-card">
            <button type="button" data-slide={i} data-full={full(s.file)} data-thumb={thumb(s.file)} data-alt={s.alt} data-caption={`${s.n} — ${s.caption}`} aria-label={`Enlarge slide ${s.n}: ${s.caption}`}>
              <img src={thumb(s.file)} alt={s.alt} loading={i < 2 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} decoding="async" width="560" height="315" />
            </button>
            <figcaption><b>{s.n}</b>{s.caption}{s.time && <time>at {s.time} in the class video</time>}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
  <dialog class="lightbox" data-lightbox aria-label="Slide viewer">
    <div class="lightbox__bar">
      <button class="icon-btn" type="button" data-prev aria-label="Previous slide"><Icon name="left" /></button>
      <button class="icon-btn" type="button" data-next aria-label="Next slide"><Icon name="right" /></button>
      <span class="lightbox__count" data-count></span>
      <button class="icon-btn" type="button" data-close aria-label="Close slide viewer"><Icon name="close" /></button>
    </div>
    <div class="lightbox__stage"><img alt="" /></div>
    <p class="lightbox__caption" data-caption></p>
  </dialog>
</LessonShell>
