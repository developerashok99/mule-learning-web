---
import Base from "../../layouts/Base.astro";
import LessonRow from "../../components/LessonRow.astro";
import PageHead from "../../components/PageHead.astro";
import { getCourses, getLesson, getLessons, type Lesson } from "../../lib/content";

const sections = getCourses().flatMap((c) => c.sections);
const order = getLessons().map((l) => l.id);
const total = order.length;
---
<Base title="Lessons" nav="lessons">
  <div class="page page--read" data-filter-scope>
    <PageHead eyebrow="Every lesson" title="All lessons" sub="Each lesson has its lecture, summary podcast, three levels of notes and the class slides. The icons show what is available." />
    <div class="filters">
      <label class="visually-hidden" for="lesson-filter">Filter lessons</label>
      <input id="lesson-filter" class="input" type="search" placeholder="Filter by day or topic, e.g. “Day 12” or “batch”" data-filter-text />
      <label class="visually-hidden" for="lesson-section">Section</label>
      <select id="lesson-section" data-filter-section>
        <option value="">All sections</option>
        {sections.map((s) => <option value={s.id}>{s.title}</option>)}
      </select>
      <span class="small muted" data-filter-count aria-live="polite">{total} shown</span>
    </div>
    {sections.map((s) => (
      <section data-filter-group aria-labelledby={`${s.id}-h`}>
        <div class="section-head"><div><h2 id={`${s.id}-h`}>{s.title}</h2>{s.description && <p>{s.description}</p>}</div><span class="pill">{s.lessons.length} lessons</span></div>
        <div class="card" style="padding-block:.25rem">
          <ul class="lesson-list">{s.lessons.map((id) => <LessonRow lesson={getLesson(id) as Lesson} n={order.indexOf(id) + 1} />)}</ul>
        </div>
      </section>
    ))}
    <p class="empty" data-filter-empty hidden style="margin-top:1rem">No lessons match. Clear the filter to see all {total}.</p>
  </div>
</Base>
