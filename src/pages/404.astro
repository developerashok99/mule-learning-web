---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Page not found">
  <div class="page page--narrow">
    <PageHead eyebrow="404" title="This page doesn't exist" sub="The link may be old, or the lesson resource (for example a podcast or slides) isn't available for that lesson." />
    <div class="btn-row">
      <a class="btn btn--primary" href={base}><Icon name="home" /> Home</a>
      <a class="btn" href={`${base}lessons/`}><Icon name="lessons" /> All lessons</a>
      <a class="btn" href={`${base}search/`}><Icon name="search" /> Search</a>
    </div>
  </div>
</Base>
