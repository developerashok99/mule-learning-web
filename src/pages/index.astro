---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { getCourses, getLessons, getPodcasts } from "../lib/content";
import { lessonPath, withBase } from "../lib/routes";

const base = import.meta.env.BASE_URL;
const lessons = getLessons();
const courses = getCourses();
const index = lessons.map((l) => ({ id: l.id, label: l.label, title: l.title, href: withBase(base, lessonPath(l.id)), section: l.sectionTitle }));
const first = lessons[0];
const withVideo = lessons.filter((l) => l.lecture?.youtubeId && !l.lecture.demo).length;
const withPodcast = getPodcasts().filter((p) => !p.test && (p.audioUrl || p.videoUrl)).length;
---
<Base title="Home" nav="home">
  <div class="container" data-dashboard>
    <script is:inline type="application/json" data-lesson-index set:html={JSON.stringify(index).replace(/</g, "\\u003c")} />
    <div class="page-head">
      <h1>Study dashboard</h1>
      <p>Lectures, summary podcasts and notes for the MuleSoft course in one place.</p>
    </div>
    <form class="hero-search" action={withBase(base, "search/")} method="get" role="search">
      <label class="visually-hidden" for="home-q">Search notes and lessons</label>
      <input id="home-q" class="input" type="search" name="q" placeholder="Search notes, e.g. “error mapping”, “watermark”, “OAuth”" />
      <button class="btn btn--primary" type="submit"><Icon name="search" /> Search</button>
    </form>

    <div class="grid grid--2">
      <section class="card continue-card" data-continue aria-labelledby="cont-h">
        <h2 id="cont-h" class="card-title" style="margin:0"><Icon name="play" /> Continue learning</h2>
        <div>
          <p class="eyebrow" data-c-eyebrow>Start here</p>
          <h3 data-c-title>{first.label} — {first.title}</h3>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" data-c-go href={withBase(base, lessonPath(first.id))}><span data-text>Start the course</span> <Icon name="right" /></a>
        </div>
        <p class="small muted" data-next-up hidden style="margin:0">Next up: <a href="#"></a></p>
      </section>

      <section class="card" aria-labelledby="prog-h">
        <h2 id="prog-h" class="card-title"><Icon name="check" /> Course progress</h2>
        <div data-section-progress={lessons.map((l) => l.id).join(",")}>
          <p class="stat-line"><strong data-total-done>0</strong><span class="muted">of {lessons.length} lessons completed</span></p>
          <div class="progress"><span></span></div>
        </div>
        <div class="section-progress">
          {courses.flatMap((c) => c.sections).map((s) => (
            <a href={withBase(base, `courses/${courses[0].id}/#${s.id}`)} data-section-progress={s.lessons.join(",")}>
              <span>{s.title}</span><span class="small muted" data-count>0 of {s.lessons.length} done</span>
              <div class="progress progress--thin"><span></span></div>
            </a>
          ))}
        </div>
      </section>

      <section class="card" aria-labelledby="recent-h">
        <h2 id="recent-h" class="card-title"><Icon name="clock" /> Recently opened</h2>
        <ul class="mini-list" data-recent hidden></ul>
        <p class="muted small" data-empty style="margin:0">Lessons you open will appear here.</p>
      </section>

      <section class="card" aria-labelledby="played-h">
        <h2 id="played-h" class="card-title"><Icon name="podcast" /> Recently played podcasts</h2>
        <ul class="mini-list" data-played hidden></ul>
        <p class="muted small" data-empty style="margin:0">Podcasts you listen to will appear here, with where you stopped. <a href={withBase(base, "podcasts/")}>Browse podcasts</a></p>
      </section>

      <section class="card" aria-labelledby="bm-h">
        <h2 id="bm-h" class="card-title"><Icon name="bookmark" /> Bookmarks</h2>
        <ul class="mini-list" data-bookmarks hidden></ul>
        <p class="muted small" data-empty style="margin:0">Use <b>Bookmark</b> on any lesson to keep it here.</p>
      </section>

      <section class="card" aria-labelledby="course-h">
        <h2 id="course-h" class="card-title"><Icon name="courses" /> Course overview</h2>
        {courses.map((c) => (
          <>
            <p style="margin:0 0 .5rem"><a href={withBase(base, `courses/${c.id}/`)}><b>{c.title}</b></a></p>
            <p class="small muted" style="margin:0 0 .75rem">{c.description}</p>
          </>
        ))}
        <ul class="mini-list small">
          <li><a href={withBase(base, "lessons/")}><span>{lessons.length} lessons with notes and slides</span><small>All lessons →</small></a></li>
          <li><a href={withBase(base, "podcasts/")}><span>{withPodcast ? `${withPodcast} summary podcasts` : "Summary podcasts: not added yet"}</span><small>Podcasts →</small></a></li>
          <li><a href={withBase(base, "about/")}><span>{withVideo ? `${withVideo} lecture videos linked` : "Lecture videos: not linked yet"}</span><small>How to add →</small></a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
