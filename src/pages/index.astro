---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import ProgressBar from "../components/ProgressBar.astro";
import { getCourses, getLessons } from "../lib/content";
import { lessonHasView, lessonPath, withBase, type View } from "../lib/routes";

const base = import.meta.env.BASE_URL;
const lessons = getLessons();
const course = getCourses()[0];
const RES: { view: View; label: string }[] = [
  { view: "lecture", label: "Overview" },
  { view: "podcast", label: "Podcast" },
  { view: "simple", label: "Simple" },
  { view: "detailed", label: "Detailed" },
  { view: "super", label: "Super-detailed" },
  { view: "slides", label: "Slides" },
  { view: "revise", label: "Revise" },
];
// Everything the dashboard script needs; progress itself comes from this browser's storage.
const index = lessons.map((l) => ({
  id: l.id,
  label: l.label,
  title: l.title,
  href: withBase(base, lessonPath(l.id)),
  section: l.sectionTitle,
  secs: l.lecture?.duration ?? 0,
  video: l.lecture?.youtubeId ? withBase(base, `videos/${l.id}/`) : "",
  res: RES.filter((r) => lessonHasView(l, r.view)).map((r) => ({ view: r.view, label: r.label, href: withBase(base, lessonPath(l.id, r.view)) })),
}));
const first = lessons[0];
const allIds = lessons.map((l) => l.id).join(",");
const courseHref = withBase(base, `courses/${course.id}/`);
const TOOLS = [
  { href: "videos/", icon: "video", title: "Lecture videos", text: "Watch with a playlist and quick navigation.", cta: "Open video library" },
  { href: "podcasts/", icon: "podcast", title: "Podcasts & audio", text: "Listen to recaps and revisit concepts.", cta: "Explore audio" },
  { href: "revise/", icon: "edit", title: "Revision studio", text: "Review glossary terms and test yourself with flashcards.", cta: "Start revising" },
] as const;
---
<Base title="Home" nav="home">
  <div class="page" data-dashboard>
    <script is:inline type="application/json" data-lesson-index set:html={JSON.stringify(index).replace(/</g, "\\u003c")} />
    <PageHead eyebrow="Your learning workspace" title="Welcome, learner." sub="Pick up where you left off, keep your momentum, and make your next MuleSoft concept click.">
      <a slot="actions" class="btn" href={courseHref}>Explore course <Icon name="external" /></a>
    </PageHead>

    <section class="hero" aria-labelledby="cur-h" data-section-progress={allIds}>
      <div>
        <span class="pill pill--blue">● Current course</span>
        <h2 id="cur-h">Build real integrations with MuleSoft.</h2>
        <p class="sub">{course.description}</p>
        <div class="btn-row" style="margin-top:1.25rem">
          <a class="btn btn--primary" href={withBase(base, lessonPath(first.id, "simple"))} data-hero-start><Icon name="play" /><span data-text>Start learning</span></a>
          <a class="btn" href={courseHref}>Course outline</a>
        </div>
        <div class="hero__progress">
          <div class="progress-line"><span>Course progress</span><b data-count>0 of {lessons.length} done</b></div>
          <ProgressBar />
          <p class="hero__counts"><b data-n-done>0</b> completed · <b data-n-started>0</b> in progress · <b data-n-new>{lessons.length}</b> not started</p>
        </div>
      </div>
      <a class="hero-art" href={courseHref}>
        <small>{course.title}</small>
        <strong>From first flow to production-ready APIs.</strong>
        <span>{lessons.length} lessons · learning path →</span>
      </a>
    </section>

    <div class="section-head">
      <div><h2>Learning at a glance</h2><p>Your study activity, saved in this browser</p></div>
      <a class="btn btn--sm" href={withBase(base, "my-study/")}>My Study <Icon name="right" /></a>
    </div>
    <ul class="grid g4" style="list-style:none;margin:0;padding:0" aria-label="Study summary">
      <li class="card"><div class="stat"><span class="stat-icon" aria-hidden="true"><Icon name="check" /></span><div><strong data-total-done>0</strong><small>Lessons completed</small></div></div></li>
      <li class="card"><div class="stat"><span class="stat-icon" aria-hidden="true"><Icon name="clock" /></span><div><strong data-hours-done>0 h</strong><small>Lecture hours completed</small></div></div></li>
      <li class="card"><div class="stat"><span class="stat-icon stat-icon--amber" aria-hidden="true"><Icon name="bookmark" /></span><div><strong data-n-bookmarks>0</strong><small>Bookmarked lessons</small></div></div></li>
      <li class="card"><div class="stat"><span class="stat-icon stat-icon--green" aria-hidden="true"><Icon name="lessons" /></span><div><strong data-n-progress>0</strong><small>Lessons in progress</small></div></div></li>
    </ul>

    <div class="section-head">
      <div><h2 data-c-heading>Start learning</h2><p>Jump straight back into your course</p></div>
      <a class="btn btn--sm" href={withBase(base, "lessons/")}>All lessons <Icon name="right" /></a>
    </div>
    <article class="card coursebox">
      <a class="thumb" href={courseHref} aria-hidden="true" tabindex="-1">M4</a>
      <div data-c-welcome>
        <div class="pill-row"><span class="pill pill--blue">{first.label}</span><span class="pill">Start here</span></div>
        <h3>{first.label} — {first.title}</h3>
        <p class="small muted">Read the Simple notes for a five-minute overview, then watch the lecture with the Detailed notes open.</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--sm" href={withBase(base, lessonPath(first.id, "simple"))}>Start with {first.label} <Icon name="right" /></a>
          {first.lecture?.youtubeId && <a class="btn btn--sm" href={withBase(base, `videos/${first.id}/`)}>Watch lecture</a>}
        </div>
      </div>
      <div data-c-resume hidden>
        <div class="pill-row"><span class="pill pill--blue" data-c-day></span><span class="pill" data-c-eyebrow></span></div>
        <h3 data-c-title></h3>
        <p class="small muted" data-c-section></p>
        <div class="dash-read" data-c-read hidden>
          <div class="progress progress--thin"><span class="p-done"></span></div>
          <span class="small muted" data-c-read-text></span>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary btn--sm" data-c-go href="#"><span data-text>Resume lesson</span> <Icon name="right" /></a>
          <a class="btn btn--sm" data-c-watch href="#" hidden>Watch lecture</a>
        </div>
        <nav class="dash-res" aria-label="Resources for this lesson" data-c-res></nav>
      </div>
    </article>
    <p class="small muted" style="margin:.75rem 0 0" data-next-card>
      <span data-next-up><b>Recommended next:</b> <a class="dash-next" href={withBase(base, lessonPath(first.id))} data-next-link><b>{first.label}</b> {first.title}</a> <span data-next-why>The first lesson of the course.</span></span>
      <span data-next-done hidden>Every lesson is marked complete — use <a href={withBase(base, "revise/")}>Revision</a> to keep it fresh.</span>
    </p>

    <div class="section-head"><div><h2>Your study tools</h2><p>Everything you need, without losing your place</p></div></div>
    <nav class="grid g3 study-tools" aria-label="Quick links">
      {TOOLS.map((t) => (
        <a class="card card--hover" href={withBase(base, t.href)}>
          <span class="stat-icon" aria-hidden="true"><Icon name={t.icon} /></span>
          <h3>{t.title}</h3>
          <p class="small muted">{t.text}</p>
          <b>{t.cta} →</b>
        </a>
      ))}
    </nav>

    <div class="section-head"><div><h2>Recent activity</h2><p>Only what you have done in this browser</p></div></div>
    <div class="grid g2">
      <section class="card" aria-labelledby="recent-h">
        <h3 id="recent-h" class="card-title"><Icon name="clock" /> Recently opened</h3>
        <ul class="mini-list" data-recent hidden></ul>
        <p class="muted small" data-empty style="margin:0">Lessons you open will appear here.</p>
      </section>
      <section class="card" aria-labelledby="ip-h">
        <h3 id="ip-h" class="card-title"><Icon name="lessons" /> In progress</h3>
        <ul class="mini-list" data-in-progress hidden></ul>
        <p class="muted small" data-empty style="margin:0">Lessons you have opened but not marked complete appear here.</p>
      </section>
      <section class="card" aria-labelledby="bm-h">
        <h3 id="bm-h" class="card-title"><Icon name="bookmark" /> Bookmarks</h3>
        <ul class="mini-list" data-bookmarks hidden></ul>
        <p class="muted small" data-empty style="margin:0">Use <b>Bookmark</b> on any lesson to keep it here.</p>
      </section>
      <section class="card" aria-labelledby="played-h">
        <h3 id="played-h" class="card-title"><Icon name="podcast" /> Recently played podcasts</h3>
        <ul class="mini-list" data-played hidden></ul>
        <p class="muted small" data-empty style="margin:0">Podcasts you listen to appear here with where you stopped. <a href={withBase(base, "podcasts/")}>Browse podcasts</a></p>
      </section>
    </div>
  </div>
</Base>
