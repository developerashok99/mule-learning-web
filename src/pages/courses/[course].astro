---
import ProgressBar from "../../components/ProgressBar.astro";
import Base from "../../layouts/Base.astro";
import LessonRow from "../../components/LessonRow.astro";
import { getCourses, getLesson, type Lesson } from "../../lib/content";
import type { Course } from "../../lib/config";
import { withBase } from "../../lib/routes";

export function getStaticPaths() {
  return getCourses().map((course) => ({ params: { course: course.id }, props: { course } }));
}
const { course } = Astro.props as { course: Course };
const base = import.meta.env.BASE_URL;
const ids = course.sections.flatMap((s) => s.lessons);
---
<Base title={course.title} nav="courses">
  <div class="container container--narrow">
    <ol class="breadcrumb"><li><a href={withBase(base, "courses/")}>Courses</a></li><li>{course.title}</li></ol>
    <div class="page-head">
      <h1>{course.title}</h1>
      <p>{course.description}</p>
    </div>
    <div class="card" data-section-progress={ids.join(",")} style="margin-bottom:2rem">
      <p class="stat-line" style="margin-bottom:.4rem"><strong>{ids.length}</strong><span class="muted">lessons · <span data-count>0 of {ids.length} done</span></span></p>
      <ProgressBar />
    </div>
    {course.sections.map((s, i) => (
      <section class="section-block" id={s.id} aria-labelledby={`${s.id}-h`} data-section-progress={s.lessons.join(",")}>
        <div class="section-block__head">
          <h2 id={`${s.id}-h`}>{i + 1}. {s.title}</h2>
          <span class="small muted" data-count>0 of {s.lessons.length} done</span>
          {s.description && <p>{s.description}</p>}
        </div>
        <ul class="lesson-list">
          {s.lessons.map((id) => <LessonRow lesson={getLesson(id) as Lesson} />)}
        </ul>
      </section>
    ))}
  </div>
</Base>
