---
import ProgressBar from "../../components/ProgressBar.astro";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LessonRow from "../../components/LessonRow.astro";
import PageHead from "../../components/PageHead.astro";
import { getCourses, getLesson, type Lesson } from "../../lib/content";
import type { Course } from "../../lib/config";
import { lessonPath, withBase } from "../../lib/routes";

export function getStaticPaths() {
  return getCourses().map((course) => ({ params: { course: course.id }, props: { course } }));
}
const { course } = Astro.props as { course: Course };
const base = import.meta.env.BASE_URL;
const ids = course.sections.flatMap((s) => s.lessons);
const lessons = ids.map((id) => getLesson(id) as Lesson);
const videos = lessons.filter((l) => l.lecture?.youtubeId).length;
const interviews = ids.filter((id) => /^interview/.test(id)).length;
// course order for the browser's "Continue" button and milestone (progress itself is read from this browser's storage)
const order = lessons.map((l) => ({ id: l.id, label: l.label, title: l.title, section: l.sectionTitle, href: withBase(base, lessonPath(l.id)) }));
// "Day 1 – Day 10" style range for a section, from its lessons' own labels
const range = (s: Course["sections"][number]) => {
  const short = (id: string) => (getLesson(id)?.label ?? "").replace(/^Interview /, "");
  const a = short(s.lessons[0]);
  const b = short(s.lessons[s.lessons.length - 1]);
  return s.lessons.length > 1 ? `${a} – ${b}` : a;
};
const first = lessons[0];
---
<Base title={course.title} nav="courses">
  <div class="page">
    <ol class="breadcrumb"><li><a href={withBase(base, "courses/")}>Courses</a></li><li>{course.title}</li></ol>
    <PageHead eyebrow="Structured learning" title={course.title} sub="A clear path through concepts, with progress and lesson status in one place.">
      <span slot="actions" class="pill pill--green">{ids.length} lessons</span>
    </PageHead>

    <section class="hero" aria-label="Your progress in this course" data-section-progress={ids.join(",")}>
      <div>
        <span class="pill pill--blue">Foundation path</span>
        <p class="sub" style="margin-top:.85rem">{course.description}</p>
        <div class="pill-row" style="margin-top:1rem">
          <span class="pill">{ids.length} lessons</span>
          <span class="pill">{course.sections.length} sections</span>
          {interviews > 0 && <span class="pill">{interviews} interview sessions</span>}
          {videos > 0 && <span class="pill">Notes + videos + revision</span>}
        </div>
        <div class="hero__progress">
          <div class="progress-line"><span>Your progress</span><b data-pct>0%</b></div>
          <ProgressBar />
          <p class="hero__counts" data-count>0 of {ids.length} done</p>
        </div>
        <div class="btn-row" style="margin-top:1.1rem">
          <a class="btn btn--primary" href={order[0]?.href} data-course-continue={JSON.stringify(order)}>
            <span data-text>Start with {order[0]?.label}</span><Icon name="right" />
          </a>
        </div>
        <p class="hero__counts" data-course-last hidden><Icon name="clock" /> Last studied: <a href="#"></a> <span data-when></span></p>
      </div>
      <a class="hero-art" href={order[0]?.href} data-milestone>
        <small>Your next milestone</small>
        <strong data-milestone-text>Start with {first.sectionTitle} and build your first Mule application.</strong>
        <span data-milestone-next>Next: {first.label} · {first.title} →</span>
      </a>
    </section>

    <div class="section-head" id="curriculum">
      <div><h2>Course curriculum</h2><p>Expand a section to explore its lessons</p></div>
      <button class="btn btn--sm" type="button" data-expand-all aria-pressed="false">Expand all sections</button>
    </div>
    <div class="curriculum" data-curriculum>
      {course.sections.map((s, i) => (
        <details class="card" id={s.id} data-section-progress={s.lessons.join(",")} open={i === 0}>
          <summary>
            <span class="row">
              <span class="stat-icon" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span>
                <h2>{s.title}</h2>
                <span class="small muted">{range(s)}{s.description && <> · {s.description}</>}</span>
              </span>
            </span>
            <span class="row">
              <span class="pill section-state" data-section-state data-count="short">0/{s.lessons.length} done</span>
              <Icon name="chevronDown" class="chev" />
            </span>
          </summary>
          <div class="curriculum__body">
            <ul class="lesson-list">
              {s.lessons.map((id) => <LessonRow lesson={getLesson(id) as Lesson} variant="course" n={ids.indexOf(id) + 1} />)}
            </ul>
          </div>
        </details>
      ))}
    </div>
  </div>
</Base>
