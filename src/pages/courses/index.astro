---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { getCourses } from "../../lib/content";
import { withBase } from "../../lib/routes";

const base = import.meta.env.BASE_URL;
const courses = getCourses();
---
<Base title="Courses" nav="courses">
  <div class="container">
    <div class="page-head">
      <h1>Courses</h1>
      <p>Each course is divided into sections; open one to see its lessons and your progress.</p>
    </div>
    <div class="grid grid--2">
      {courses.map((c) => {
        const ids = c.sections.flatMap((s) => s.lessons);
        return (
          <article class="card" data-section-progress={ids.join(",")}>
            <h2 class="card-title" style="font-size:1.25rem"><Icon name="courses" /><a href={withBase(base, `courses/${c.id}/`)}>{c.title}</a></h2>
            <p class="muted">{c.description}</p>
            <p class="small"><b>{ids.length} lessons</b> in {c.sections.length} sections · <span data-count>0 of {ids.length} done</span></p>
            <div class="progress"><span></span></div>
            <ol class="small" style="margin:1rem 0 0;padding-left:1.25rem">
              {c.sections.map((s) => <li><a href={withBase(base, `courses/${c.id}/#${s.id}`)}>{s.title}</a> <span class="muted">({s.lessons.length})</span></li>)}
            </ol>
            <div class="btn-row" style="margin-top:1rem"><a class="btn btn--primary" href={withBase(base, `courses/${c.id}/`)}>Open course <Icon name="right" /></a></div>
          </article>
        );
      })}
    </div>
  </div>
</Base>
