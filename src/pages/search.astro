---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SearchBox from "../components/SearchBox.astro";
import { withBase } from "../lib/routes";

const base = import.meta.env.BASE_URL;

// course topics that every section of the notes covers (shown as quick searches)
const TOPICS = ["DataWeave", "RAML", "HTTP Listener", "Error handling", "Connectors", "Deployment", "Security policies", "APIkit", "Batch", "Interview"];
---
<Base title="Search" nav="search">
  <div class="container container--narrow">
    <div class="page-head">
      <h1>Search</h1>
      <p>Searches every lesson's notes, slide captions and podcast descriptions. Press <kbd>/</kbd> anywhere to come here.</p>
    </div>
    <SearchBox scope="all" syncUrl autofocus placeholder="Search notes, lessons, topics…" />
    <div class="search-idle" data-search-idle>
      <section aria-labelledby="rs-h" hidden>
        <div class="search-idle__head"><h2 id="rs-h">Recent searches</h2><button class="btn btn--ghost btn--sm" type="button" data-clear-searches>Clear</button></div>
        <ul class="recent-searches" data-recent-searches></ul>
      </section>
      <section aria-labelledby="pt-h">
        <h2 id="pt-h">Popular topics</h2>
        <div class="chips">
          {TOPICS.map((t) => <a class="chip" href={withBase(base, `search/?q=${encodeURIComponent(t)}`)}><Icon name="search" />{t}</a>)}
        </div>
      </section>
    </div>
  </div>
</Base>
