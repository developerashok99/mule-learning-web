---
/**
 * Course-wide revision hub: every lesson's revision view, and a glossary merged from the
 * "Important Terminology" tables of the super-detailed notes (meanings copied verbatim, with their lesson).
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import { getCourses, getLesson, getLessons, knownIds, readNote } from "../lib/content";
import { renderMarkdown } from "../lib/markdown";
import { lessonHasView, lessonPath, withBase } from "../lib/routes";
import { findSection, parseQuestions } from "../lib/revision";
import { glossary } from "../lib/glossary";
import { cardId } from "../lib/srs";
import { dwExercises } from "../lib/dataweave";
const dwCount = dwExercises().length;

const base = import.meta.env.BASE_URL;
const known = knownIds();
const inline = async (text: string, sid: string) =>
  (await renderMarkdown(text, { kind: "super", sid, base, known })).html.replace(/^<p>|<\/p>\s*$/g, "");

const qCount = new Map<string, number>();
// flashcards: every interview question of the super-detailed notes, with its answer copied unchanged
const cards: { id: string; s: string; d: string; l: string; href: string; q: string; a: string }[] = [];
for (const l of getLessons()) {
  const src = readNote(l.id, "super");
  const q = findSection(src, /interview question|questions discussed/i);
  const qs = q ? parseQuestions(q.body) : [];
  qCount.set(l.id, qs.length);
  for (const x of qs) {
    cards.push({
      id: cardId(l.id, x.question),
      s: l.sectionId,
      d: l.sectionTitle,
      l: l.label,
      href: withBase(base, lessonPath(l.id, "revise")) + "#rv-selftest",
      q: await inline(x.question, l.id),
      a: (await renderMarkdown(x.answer, { kind: "super", sid: l.id, base, known })).html,
    });
  }
}
// the glossary, rendered (meanings word for word, each with its lessons)
const sortKey = (k: string) => k.replace(/^[^a-z0-9]+/, "") || k;
const sorted = await Promise.all(glossary().map(async (e) => ({
  key: e.key,
  term: await inline(e.term, e.meanings[0].lessons[0]),
  meanings: await Promise.all(e.meanings.map(async (m) => ({ html: await inline(m.md, m.lessons[0]), lessons: m.lessons }))),
})));
const letterOf = (k: string) => {
  const c = sortKey(k)[0]?.toUpperCase() ?? "#";
  return /[A-Z]/.test(c) ? c : "#";
};
const letters = [...new Set(sorted.map((e) => letterOf(e.key)))];
const sections = getCourses().flatMap((c) => c.sections);
const withTests = [...qCount.values()].filter((n) => n > 0).length;
const decks = sections.map((sec) => ({ id: sec.id, title: sec.title, n: cards.filter((c) => c.s === sec.id).length })).filter((d) => d.n > 0);
---
<Base title="Revision" nav="revise" description="Revision studio: flashcards from the interview questions, a glossary of key terms and per-lesson self-tests">
  <div class="page page--read">
    <PageHead eyebrow="Recall before rereading" title="Revision studio" sub="Strengthen recall with flashcards, concise definitions and self-checks, all taken word for word from the notes.">
      <span slot="actions" class="pill pill--blue">Practice mode</span>
    </PageHead>
    <ul class="grid g3" style="list-style:none;margin:0;padding:0" aria-label="Revision material">
      <li class="card"><div class="stat"><span class="stat-icon" aria-hidden="true">Aa</span><div><strong>{sorted.length}</strong><small>Glossary terms</small></div></div><p class="small muted" style="margin:.75rem 0 0">From the “Important Terminology” tables of the notes.</p></li>
      <li class="card"><div class="stat"><span class="stat-icon" aria-hidden="true"><Icon name="layers" /></span><div><strong>{cards.length}</strong><small>Flashcards</small></div></div><p class="small muted" style="margin:.75rem 0 0">The interview questions, with their answers hidden until you reveal them.</p></li>
      <li class="card"><div class="stat"><span class="stat-icon" aria-hidden="true"><Icon name="check" /></span><div><strong>{withTests}</strong><small>Lesson self-tests</small></div></div><p class="small muted" style="margin:.75rem 0 0">Outline, must-remember points and a self-test for each lesson.</p></li>
    </ul>
    <div class="grid g2 practice-links">
      <a class="card card--hover dw-promo" href={withBase(base, "revise/concept-map/")}>
        <span class="stat-icon" aria-hidden="true"><Icon name="layers" /></span>
        <span><b>Concept map</b><small>See how the terms connect, then rebuild a term's links from memory</small></span>
        <Icon name="right" />
      </a>
      {dwCount > 0 && (
        <a class="card card--hover dw-promo" href={withBase(base, "revise/dataweave/")}>
          <span class="stat-icon" aria-hidden="true">dw</span>
          <span><b>DataWeave practice</b><small>{dwCount} exercises: predict what a script returns, or write the script for an output</small></span>
          <Icon name="right" />
        </a>
      )}
    </div>

    {cards.length > 0 && (
      <section aria-labelledby="fc-h" data-flashcards>
        <script is:inline type="application/json" data-cards set:html={JSON.stringify(cards).replace(/</g, "\\u003c")} />
        <div class="section-head">
          <div><h2 id="fc-h">Flashcard practice</h2><p data-fc-summary>Try to answer before revealing the explanation</p></div>
          <div class="segmented" role="group" aria-label="Practice mode">
            <button type="button" data-fc-mode="review" aria-pressed="true">Review <span data-fc-due></span></button>
            <button type="button" data-fc-mode="browse" aria-pressed="false">Browse all</button>
          </div>
        </div>
        <div class="card flashcard" tabindex="-1">
          <div class="pill-row" style="justify-content:center"><span class="pill pill--blue" data-fc-topic>{cards[0].d} · {cards[0].l}</span><span class="pill" data-fc-count aria-live="polite">Card 1 of {cards.length}</span></div>
          <div class="flashcard__q" data-fc-q set:html={cards[0].q} />
          <div class="prose flashcard__a" data-fc-a hidden set:html={cards[0].a} />
          <p class="flashcard__src" data-fc-src hidden><a href={cards[0].href}>Open the {cards[0].l} self-test →</a></p>
          <button class="btn btn--primary" type="button" data-fc-reveal aria-expanded="false">Reveal answer</button>
          <div class="grade-row" data-fc-grades hidden role="group" aria-label="How well did you remember it?">
            <button class="btn grade grade--again" type="button" data-grade="again">Again <small data-wait="again"></small></button>
            <button class="btn grade grade--hard" type="button" data-grade="hard">Hard <small data-wait="hard"></small></button>
            <button class="btn grade grade--good" type="button" data-grade="good">Good <small data-wait="good"></small></button>
            <button class="btn grade grade--easy" type="button" data-grade="easy">Easy <small data-wait="easy"></small></button>
          </div>
          <div class="btn-row" style="margin-top:1rem" data-fc-browse hidden>
            <button class="btn" type="button" data-fc-prev><Icon name="left" /> Previous</button>
            <button class="btn" type="button" data-fc-shuffle aria-pressed="false">Shuffle</button>
            <button class="btn" type="button" data-fc-next>Next card <Icon name="right" /></button>
          </div>
        </div>
        <div class="card flashcard flashcard--done" data-fc-done hidden>
          <span class="stat-icon stat-icon--green" aria-hidden="true"><Icon name="check" /></span>
          <h3 style="margin:.8rem 0 .3rem">All caught up</h3>
          <p class="muted" data-fc-next-due style="margin:0 0 1rem">Nothing is due right now.</p>
          <div class="btn-row">
            <button class="btn btn--primary" type="button" data-fc-more>Learn more new cards</button>
            <button class="btn" type="button" data-fc-mode="browse">Browse all</button>
          </div>
        </div>
        <details class="srs-help">
          <summary>How the review schedule works</summary>
          <p>After you reveal the answer, grade how well you remembered it. <b>Again</b> shows the card again in 10 minutes and restarts it. <b>Hard</b> brings a new card back in 12 hours, and later waits a little longer than last time. <b>Good</b> waits 1 day, then 3 days, then about 2.5× longer each time. <b>Easy</b> waits even longer. Each grade's wait is shown on its button. Review shows the cards that are due first, then up to <span data-fc-per-day>15</span> new cards a day (change this in Preferences). The schedule is kept in this browser and included in My Study backups.</p>
        </details>
        <div class="section-head"><div><h2>Topic collections</h2><p>Choose a subject to revise</p></div></div>
        <div class="grid g3" role="group" aria-label="Flashcard topics">
          <button class="card card--hover topic-card" type="button" data-deck="" aria-pressed="true">
            <span class="stat-icon" aria-hidden="true">All</span>
            <h3>Whole course</h3>
            <span class="small muted">Every question in course order</span>
            <span class="small" data-deck-stat=""></span>
            <span class="pill">{cards.length} cards</span>
          </button>
          {decks.map((d) => (
            <button class="card card--hover topic-card" type="button" data-deck={d.id} aria-pressed="false">
              <span class="stat-icon" aria-hidden="true">{d.title.split(/[\s&]+/).filter(Boolean).map((w) => w[0]).join("").slice(0, 2)}</span>
              <h3>{d.title}</h3>
              <span class="small muted">Interview questions from this section</span>
              <span class="small" data-deck-stat={d.id}></span>
              <span class="pill">{d.n} cards</span>
            </button>
          ))}
        </div>
      </section>
    )}

    <section class="revise-lessons" aria-labelledby="rv-lessons">
      <div class="section-head"><div><h2 id="rv-lessons">Revise a lesson</h2><p>Outline, Must Remember, Quick Recap, key terms, a self-test from the interview questions, and the code examples.</p></div></div>
      {sections.map((sec) => (
        <details class="card">
          <summary>{sec.title} <span class="pill">{sec.lessons.length} lessons</span></summary>
          <ul class="study-list">
            {sec.lessons.map((id) => getLesson(id)!).filter((l) => lessonHasView(l, "revise")).map((l) => (
              <li data-lesson-done={l.id}>
                <span class="done-mark" aria-hidden="true"><Icon name="check" /></span>
                <span class="visually-hidden" data-status-label>Not started</span>
                <a href={withBase(base, lessonPath(l.id, "revise"))}><b>{l.label}</b> — {l.title}</a>
                {qCount.get(l.id) ? <small>{qCount.get(l.id)} questions</small> : null}
              </li>
            ))}
          </ul>
        </details>
      ))}
    </section>

    <section aria-labelledby="rv-glossary" data-filter-scope>
      <div class="section-head"><div>
        <h2 id="rv-glossary">Glossary</h2>
        <p>{sorted.length} terms from the “Important Terminology” tables of the super-detailed notes. Where lessons define a term differently, each definition is shown with its lesson.</p>
      </div></div>
      <div class="card">
      <div class="filters">
        <label class="visually-hidden" for="gl-filter">Filter the glossary</label>
        <input id="gl-filter" class="input" style="max-width:24rem" type="search" placeholder="Filter terms, e.g. “vCore”, “payload”" data-filter-text />
        <span class="small muted" data-filter-count aria-live="polite"></span>
      </div>
      <nav class="chips glossary-letters" aria-label="Glossary letters">
        {letters.map((L) => <a class="chip" href={`#gl-${L === "#" ? "other" : L.toLowerCase()}`}>{L}</a>)}
      </nav>
      {letters.map((L) => (
        <details class="glossary-group" data-filter-group id={`gl-${L === "#" ? "other" : L.toLowerCase()}`}>
          <summary><h3>{L === "#" ? "Other" : L}</h3><span class="small muted">{sorted.filter((e) => letterOf(e.key) === L).length} terms</span></summary>
          <dl class="glossary">
            {sorted.filter((e) => letterOf(e.key) === L).map((e) => (
              <div class="glossary__item" data-filter-item={`${e.key} ${e.meanings.map((m) => m.html.replace(/<[^>]+>/g, "")).join(" ")}`}>
                <dt set:html={e.term} />
                {e.meanings.map((m) => (
                  <dd>
                    <span set:html={m.html} />
                    <span class="glossary__src">
                      {m.lessons.map((id, i) => <>{i > 0 && ", "}<a href={withBase(base, lessonPath(id, "super"))}>{getLesson(id)?.label}</a></>)}
                    </span>
                  </dd>
                ))}
              </div>
            ))}
          </dl>
        </details>
      ))}
      <p class="empty" data-filter-empty hidden>No terms match.</p>
      </div>
    </section>
  </div>
</Base>
