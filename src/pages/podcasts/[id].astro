---
import Base from "../../layouts/Base.astro";
import PodcastPlayer from "../../components/PodcastPlayer.astro";
import Icon from "../../components/Icon.astro";
import PageHead from "../../components/PageHead.astro";
import { getPodcasts } from "../../lib/content";
import type { Episode } from "../../lib/config";
import { podcastPath, withBase } from "../../lib/routes";

export function getStaticPaths() {
  const all = getPodcasts();
  return all.map((episode, i) => ({ params: { id: episode.id }, props: { episode, prev: all[i - 1] ?? null, next: all[i + 1] ?? null } }));
}
const { episode, prev, next } = Astro.props as { episode: Episode; prev: Episode | null; next: Episode | null };
const base = import.meta.env.BASE_URL;
---
<Base title={episode.title} nav="podcasts" description={episode.description || `Summary podcast: ${episode.title}`}>
  <div class="page page--narrow">
    <ol class="breadcrumb"><li><a href={withBase(base, "podcasts/")}>Podcasts</a></li><li>{episode.title}</li></ol>
    {/* Only episodes with media are indexed for search; empty slots would just clutter results. */}
    <div data-pagefind-body={episode.audioUrl || episode.videoUrl ? "" : undefined} data-pagefind-filter={episode.audioUrl || episode.videoUrl ? "type:Podcast" : undefined}>
      <PageHead eyebrow="Summary podcast" title={episode.title} sub="Listen or watch while you study: a short summary for revision and on the go." />
      <PodcastPlayer episode={episode} headingLevel={2} standalone />
    </div>
    <nav class="lesson-pager" aria-label="Previous and next episode">
      {prev && <a class="nav-card" href={withBase(base, podcastPath(prev.id))}><Icon name="left" /><span class="nav-card__text"><small>Previous episode</small><strong>{prev.title}</strong></span></a>}
      {next && <a class="nav-card nav-card--next" href={withBase(base, podcastPath(next.id))}><span class="nav-card__text"><small>Next episode</small><strong>{next.title}</strong></span><Icon name="right" /></a>}
    </nav>
  </div>
</Base>
