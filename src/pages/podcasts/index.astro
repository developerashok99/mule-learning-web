---
import Base from "../../layouts/Base.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";
import Icon from "../../components/Icon.astro";
import { getCourses, getPodcasts } from "../../lib/content";

const sections = getCourses().flatMap((c) => c.sections);
const episodes = getPodcasts();
const ready = episodes.filter((e) => !e.test && (e.audioUrl || e.videoUrl)).length;
const tests = episodes.filter((e) => e.test);
const real = episodes.filter((e) => !e.test);
---
<Base title="Podcasts" nav="podcasts">
  <div class="container container--narrow" data-filter-scope>
    <div class="page-head">
      <h1>Summary podcasts</h1>
      <p>Short summaries of the lectures. Each episode comes as a <b>video podcast</b> (slides, animation, narration) and an <b>audio podcast</b> with the same content. They are for revision — not a replacement for the full lecture or the notes.</p>
    </div>
    {ready === 0 && (
      <div class="notice notice--warn" style="margin-bottom:1.25rem">
        <Icon name="info" />
        <div><strong>The real podcast files haven't been added yet</strong><p>Each lesson already has an episode slot in config/media.json. Until the MP3/MP4 links are added, episodes show “not added yet”. The “Player test” episode uses tiny bundled test media so the players can be tried now.</p></div>
      </div>
    )}
    <div class="filters">
      <label class="visually-hidden" for="pod-filter">Filter episodes</label>
      <input id="pod-filter" class="input" style="max-width:20rem" type="search" placeholder="Filter episodes" data-filter-text />
      <label class="visually-hidden" for="pod-section">Section</label>
      <select id="pod-section" data-filter-section>
        <option value="">All sections</option>
        {sections.map((s) => <option value={s.id}>{s.title}</option>)}
      </select>
      <label class="switch"><input type="checkbox" data-filter-available /> Playable only</label>
      <span class="small muted" data-filter-count aria-live="polite"></span>
    </div>
    {tests.length > 0 && (
      <section class="section-block" data-filter-group aria-labelledby="pt-h">
        <div class="section-block__head"><h2 id="pt-h">Player test</h2></div>
        <ul class="episode-list">{tests.map((ep) => <EpisodeCard episode={ep} />)}</ul>
      </section>
    )}
    {sections.map((s) => {
      const eps = real.filter((e) => e.lessons.some((l) => s.lessons.includes(l)));
      return eps.length > 0 && (
        <section class="section-block" data-filter-group aria-labelledby={`p-${s.id}`}>
          <div class="section-block__head"><h2 id={`p-${s.id}`}>{s.title}</h2></div>
          <ul class="episode-list">{eps.map((ep) => <EpisodeCard episode={ep} />)}</ul>
        </section>
      );
    })}
    {real.filter((e) => !e.lessons.length).length > 0 && (
      <section class="section-block" data-filter-group>
        <div class="section-block__head"><h2>Other episodes</h2></div>
        <ul class="episode-list">{real.filter((e) => !e.lessons.length).map((ep) => <EpisodeCard episode={ep} />)}</ul>
      </section>
    )}
    <p class="empty" data-filter-empty hidden>No episodes match. Clear the filters to see all.</p>
  </div>
</Base>
