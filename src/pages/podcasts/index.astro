---
import Base from "../../layouts/Base.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";
import Icon from "../../components/Icon.astro";
import PageHead from "../../components/PageHead.astro";
import { getCourses, getPodcastPlaylist, getPodcasts } from "../../lib/content";
import { playlistUrl } from "../../lib/youtube";
import { formatLength } from "../../lib/duration";
import { podcastPath, withBase } from "../../lib/routes";

const base = import.meta.env.BASE_URL;
const sections = getCourses().flatMap((c) => c.sections);
const episodes = getPodcasts();
const real = episodes.filter((e) => !e.test);
const tests = episodes.filter((e) => e.test);
const playable = real.filter((e) => e.audioUrl || e.videoUrl);
// featured: the first real episode that can be played (course order)
const featured = playable[0] ?? null;
const playlist = getPodcastPlaylist();
---
<Base title="Podcasts" nav="podcasts">
  <div class="page" data-filter-scope>
    <PageHead eyebrow="Learn on the go" title="Podcasts & audio" sub="Revisit ideas through short recaps of the lectures, as video podcast episodes and audio. They are for revision, not a replacement for the full lecture or the notes.">
      <Fragment slot="actions">
        <span class="pill pill--blue web-only">Persistent mini-player</span>
        <a class="btn btn--primary app-only" href={withBase(base, "downloads/")}><Icon name="download" /> Downloads</a>
        {playlist && <a class="btn" href={playlistUrl(playlist)} target="_blank" rel="noopener noreferrer"><Icon name="external" /> Playlist on YouTube</a>}
      </Fragment>
    </PageHead>

    {featured ? (
      <section class="card podcast-feature" aria-labelledby="feat-h">
        <div class="podart" aria-hidden="true"><small>MULE · AUDIO NOTES</small><strong>Understand it.<br />Remember it.</strong><small>LISTEN &amp; REVISE</small></div>
        <div>
          <span class="pill pill--blue">Featured episode</span>
          <h2 id="feat-h">{featured.title}</h2>
          <p class="sub">{featured.description || "A short summary of the lecture."}{featured.duration != null && <> · {formatLength(featured.duration)}</>}</p>
          <div class="btn-row" style="margin-top:1rem">
            {featured.audioUrl
              ? <button class="btn btn--primary" type="button" data-play-episode={featured.id} data-label={featured.title} aria-label={`Play episode: ${featured.title}`}><Icon name="play" /> Play episode</button>
              : <a class="btn btn--primary" href={withBase(base, podcastPath(featured.id))}><Icon name="play" /> Watch episode</a>}
            <a class="btn" href={withBase(base, "revise/")}>Review key terms</a>
          </div>
          <p class="tiny muted" style="margin:.75rem 0 0">{playable.length} of {real.length} episodes are available now. Audio keeps playing in the mini-player while you move around the site.</p>
        </div>
      </section>
    ) : (
      <div class="notice notice--warn">
        <Icon name="info" />
        <div><strong>The real podcast files haven't been added yet</strong><p>Each lesson already has an episode slot in config/media.json. Until the MP3/MP4 links are added, episodes show “not added yet”. The “Player test” episode uses tiny bundled test media so the players can be tried now.</p></div>
      </div>
    )}

    <div class="section-head">
      <div><h2>Browse episodes</h2><p>Choose an episode; the mini-player stays available as you navigate</p></div>
    </div>
    <div class="filters">
      <label class="visually-hidden" for="pod-filter">Filter episodes</label>
      <input id="pod-filter" class="input" type="search" placeholder="Filter episodes" data-filter-text />
      <label class="visually-hidden" for="pod-kind">Format</label>
      <select id="pod-kind" data-filter-kind>
        <option value="">All episodes</option>
        <option value="audio">Audio</option>
        <option value="video">Video podcast</option>
      </select>
      <label class="visually-hidden" for="pod-section">Section</label>
      <select id="pod-section" data-filter-section>
        <option value="">All sections</option>
        {sections.map((s) => <option value={s.id}>{s.title}</option>)}
      </select>
      <label class="switch"><input type="checkbox" data-filter-available /> Playable only</label>
      <span class="small muted" data-filter-count aria-live="polite"></span>
    </div>
    {tests.length > 0 && (
      <section data-filter-group aria-labelledby="pt-h" style="margin-bottom:1.5rem">
        <h3 id="pt-h" class="video-list__section" style="position:static;padding-left:0">Player test</h3>
        <ul class="episode-list">{tests.map((ep) => <EpisodeCard episode={ep} />)}</ul>
      </section>
    )}
    {sections.map((s) => {
      const eps = real.filter((e) => e.lessons.some((l) => s.lessons.includes(l)));
      return eps.length > 0 && (
        <section data-filter-group aria-labelledby={`p-${s.id}`} style="margin-bottom:1.5rem">
          <h3 id={`p-${s.id}`} class="video-list__section" style="position:static;padding-left:0">{s.title}</h3>
          <ul class="episode-list">{eps.map((ep) => <EpisodeCard episode={ep} />)}</ul>
        </section>
      );
    })}
    {real.filter((e) => !e.lessons.length).length > 0 && (
      <section data-filter-group aria-labelledby="p-other">
        <h3 id="p-other" class="video-list__section" style="position:static;padding-left:0">Other episodes</h3>
        <ul class="episode-list">{real.filter((e) => !e.lessons.length).map((ep) => <EpisodeCard episode={ep} />)}</ul>
      </section>
    )}
    <p class="empty" data-filter-empty hidden>No episodes match. Clear the filters to see all.</p>
  </div>
</Base>
