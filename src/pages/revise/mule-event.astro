---
/**
 * Mule event visualiser: walk through a flow component by component and watch payload, attributes, variables
 * and the error change (scenarios in src/data/mule-event.ts; src/client/muleevent.ts runs it).
 * "Guess first" asks which parts the next component changes before showing it.
 */
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PageHead from "../../components/PageHead.astro";
import { SCENARIOS } from "../../data/mule-event";
import { getLesson } from "../../lib/content";
import { withBase } from "../../lib/routes";

const base = import.meta.env.BASE_URL;
const data = SCENARIOS.map((s) => ({ ...s, steps: s.steps.map((st) => ({ ...st, label: getLesson(st.src)?.label ?? st.src })) }));
const json = JSON.stringify(data).replace(/</g, "\\u003c");
---
<Base title="Mule event visualiser" nav="revise" description="Watch the payload, attributes and variables change as a Mule event moves through a flow.">
  <div class="page" data-mev>
    <script is:inline type="application/json" data-mev-data set:html={json} />
    <PageHead eyebrow="Revision studio" title="Mule event visualiser" sub="Step through a flow and watch what each component does to the Mule event. With “Guess first” on, say what will change before you see it.">
      <a slot="actions" class="btn btn--sm" href={withBase(base, "revise/")}><Icon name="left" /> Revision studio</a>
    </PageHead>
    <div class="chips mev-scenarios" role="group" aria-label="Walkthroughs">
      {data.map((s, i) => <button class="chip" type="button" data-mev-scenario={s.id} aria-pressed={i === 0 ? "true" : "false"}>{s.title}</button>)}
    </div>
    <section class="card mev" aria-labelledby="mev-title">
      <div class="mev-head">
        <div><h2 id="mev-title" data-mev-title>{data[0].title}</h2><p class="muted" data-mev-sub>{data[0].sub}</p></div>
        <label class="mev-guess"><input type="checkbox" data-mev-guess checked /> Guess first</label>
      </div>
      <ol class="mev-pipe" data-mev-pipe aria-label="Components in this flow"></ol>
      <div class="mev-step" data-mev-step aria-live="polite"></div>
      <div class="mev-guessbox" data-mev-guessbox hidden>
        <p><b>What will <span data-mev-next></span> change?</b> Pick all that apply.</p>
        <div class="chips" role="group" aria-label="Parts of the event">
          <button class="chip" type="button" data-mev-part="payload" aria-pressed="false">Payload</button>
          <button class="chip" type="button" data-mev-part="attributes" aria-pressed="false">Attributes</button>
          <button class="chip" type="button" data-mev-part="vars" aria-pressed="false">Variables</button>
          <button class="chip" type="button" data-mev-part="error" aria-pressed="false">Error</button>
          <button class="chip" type="button" data-mev-part="none" aria-pressed="false">Nothing</button>
        </div>
      </div>
      <div class="mev-event" data-mev-event aria-label="The Mule event"></div>
      <div class="btn-row mev-nav">
        <button class="btn" type="button" data-mev-prev><Icon name="left" /> Previous</button>
        <button class="btn btn--primary" type="button" data-mev-next-btn>Next</button>
        <button class="btn btn--ghost" type="button" data-mev-restart>Start again</button>
      </div>
    </section>
    <p class="small muted">Written from the notes: each step names the lesson it comes from. Example values follow the lessons' demos and are shortened with “…”.</p>
  </div>
</Base>
