---
/**
 * Build the flow: put the steps of a diagram from the notes back in order (a Parsons-style exercise).
 * Every unbranched step chain of the notes' flowcharts (src/lib/flows.ts); src/client/flows.ts runs it.
 */
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PageHead from "../../components/PageHead.astro";
import { getLesson } from "../../lib/content";
import { flowExercises } from "../../lib/flows";
import { NOTE_LEVELS, lessonPath, withBase } from "../../lib/routes";

const base = import.meta.env.BASE_URL;
const all = flowExercises();
const levelLabel = (l: string) => NOTE_LEVELS.find((x) => x.level === l)?.label ?? l;
const lessons = [...new Set(all.map((e) => e.sid))].map((id) => getLesson(id)).filter((l) => l != null);
---
<Base title="Build the flow" nav="revise" description="Put the steps of the course's diagrams back in order.">
  <div class="page page--read" data-flows>
    <PageHead eyebrow="Revision studio" title="Build the flow" sub={`${all.length} step-by-step flows from the diagrams in your notes. Tap the steps in the order they happen, then check. Rebuilding a sequence yourself shows whether you really know how it runs.`}>
      <a slot="actions" class="btn btn--sm" href={withBase(base, "revise/")}><Icon name="left" /> Revision studio</a>
    </PageHead>
    {all.length === 0 ? <p class="empty">No step-by-step diagrams were found in the notes.</p> : (
      <>
        <div class="card dw-bar">
          <label class="dw-bar__lesson"><span class="visually-hidden">Lesson</span>
            <select class="input" data-flow-lesson aria-label="Lesson">
              <option value="">All lessons</option>
              {lessons.map((l) => <option value={l.id}>{l.label}: {l.title}</option>)}
            </select>
          </label>
          <p class="small muted dw-bar__score" data-flow-score aria-live="polite"></p>
        </div>
        <div class="dw-list">
          {all.map((e, n) => {
            const lesson = getLesson(e.sid);
            return (
              <article class="card dw flow" id={e.id} data-flow={e.id} data-sid={e.sid} data-steps={JSON.stringify(e.steps)} aria-labelledby={`${e.id}-h`}>
                <div class="pill-row">
                  {lesson && <span class="pill pill--blue">{lesson.label}</span>}
                  <span class="pill" data-flow-pos>Flow {n + 1} of {all.length}</span>
                  <span class="pill" data-flow-status hidden></span>
                </div>
                <h2 id={`${e.id}-h`} class="dw__title">{e.heading || `A flow from ${lesson?.label ?? e.sid}`}</h2>
                <p class="dw__task">Put these {e.steps.length} steps in the order they happen.</p>
                <h3 class="flow__label" id={`${e.id}-order`}>Your order</h3>
                <ol class="flow-answer" data-flow-answer aria-labelledby={`${e.id}-order`}></ol>
                <h3 class="flow__label" id={`${e.id}-pool`}>Steps left <small>tap one to add it next</small></h3>
                <div class="flow-pool" data-flow-pool role="group" aria-labelledby={`${e.id}-pool`}></div>
                <div class="btn-row">
                  <button class="btn btn--primary" type="button" data-flow-check disabled>Check</button>
                  <button class="btn" type="button" data-flow-reset>Start again</button>
                  <button class="btn btn--ghost" type="button" data-flow-show>Show the answer</button>
                </div>
                <div class="dw__result" data-flow-result hidden tabindex="-1">
                  <p class="dw__verdict" data-flow-verdict></p>
                  <h3 class="flow__label">The flow</h3>
                  <ol class="flow-solution">
                    {e.steps.map((s, i) => <li>{i > 0 && e.via[i - 1] && <span class="flow-solution__via">↓ {e.via[i - 1]}</span>}<span>{s}</span></li>)}
                  </ol>
                  <p class="small"><a href={withBase(base, lessonPath(e.sid, e.level))}>See the diagram in {lesson?.label} · {levelLabel(e.level)} <Icon name="right" /></a>{e.heading && <span class="muted"> (section “{e.heading}”)</span>}</p>
                </div>
              </article>
            );
          })}
        </div>
        <p class="empty" data-flow-empty hidden>No flows for this lesson.</p>
        <nav class="btn-row dw-nav" aria-label="Flows" data-flow-nav>
          <button class="btn" type="button" data-flow-prev><Icon name="left" /> Previous</button>
          <button class="btn" type="button" data-flow-next>Next <Icon name="right" /></button>
          <button class="btn btn--soft" type="button" data-flow-unsolved>Next unsolved</button>
        </nav>
      </>
    )}
  </div>
</Base>
