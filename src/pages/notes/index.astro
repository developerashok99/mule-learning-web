---
import Base from "../../layouts/Base.astro";
import SearchBox from "../../components/SearchBox.astro";
import PageHead from "../../components/PageHead.astro";
import { getCourses, getLesson, type Lesson } from "../../lib/content";
import { NOTE_LEVELS, lessonPath, withBase } from "../../lib/routes";
import Icon from "../../components/Icon.astro";

const base = import.meta.env.BASE_URL;
const sections = getCourses().flatMap((c) => c.sections);
---
<Base title="Notes" nav="notes">
  <div class="page page--read">
    <PageHead eyebrow="Read and review" title="Notes library" sub="Three levels for every lesson. Start with Simple for a quick review, read Detailed while studying, and use Super-detailed as the full reference with demos, troubleshooting and interview Q&A." />
    <section class="card" style="margin-bottom:1.5rem" aria-label="Search the notes">
      <SearchBox scope="notes" placeholder="Search inside all notes…" />
    </section>

    <div data-filter-scope>
      <div class="filters">
        <label class="visually-hidden" for="notes-filter">Filter lessons</label>
        <input id="notes-filter" class="input" style="max-width:24rem" type="search" placeholder="Filter lessons by day or title" data-filter-text />
        <span class="small muted" data-filter-count aria-live="polite"></span>
      </div>
      {sections.map((s) => (
        <section data-filter-group aria-labelledby={`n-${s.id}`}>
          <div class="section-head"><div><h2 id={`n-${s.id}`}>{s.title}</h2></div></div>
          <div class="card" style="padding-block:.25rem"><ul class="lesson-list">
            {s.lessons.map((id) => {
              const l = getLesson(id) as Lesson;
              return (
                <li class="lesson-row" data-filter-item={`${l.label} ${l.title}`} data-lesson-done={l.id}>
                  <span class="num" aria-hidden="true"><span class="n">{l.label.replace(/^\D+/, "") || "•"}</span><Icon name="check" /></span>
                  <div class="lesson-row__main">
                    <span class="lesson-row__title">{l.label} · {l.title}</span>
                    <div class="btn-row" style="margin-top:.5rem;gap:.35rem">
                      {NOTE_LEVELS.map(({ level, short }) =>
                        l.notes[level]
                          ? <a class="btn btn--sm" href={withBase(base, lessonPath(l.id, level))}>{short}</a>
                          : <span class="btn btn--sm" aria-disabled="true" title="Not available">{short}</span>)}
                      {l.slides > 0 && <a class="btn btn--sm btn--ghost" href={withBase(base, lessonPath(l.id, "slides"))}>Slides</a>}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul></div>
        </section>
      ))}
      <p class="empty" data-filter-empty hidden style="margin-top:1rem">No lessons match the filter.</p>
    </div>
  </div>
</Base>
