---
import { ClientRouter } from "astro:transitions";
import Icon from "../components/Icon.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import { getCourses, getManifest } from "../lib/content";
import { APP_BUILD } from "../lib/routes";
import "../styles/global.css";

type NavKey = "home" | "videos" | "courses" | "lessons" | "notes" | "podcasts" | "search" | "about" | "revise" | "mystudy" | "preferences" | "downloads";
interface Props {
  title: string;
  description?: string;
  /** Which primary nav item is current */
  nav?: NavKey;
}
const { title, description = "Personal MuleSoft study platform: lectures, summary podcasts and notes.", nav } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pageTitle = title === "Home" ? "Mule Learning Hub" : `${title} · Mule Learning Hub`;
const manifest = getManifest();
const courseCount = getCourses().length;
const DOWNLOADS = { key: "downloads", href: `${base}downloads/`, label: "Downloads", icon: "download" } as const;
// sidebar (wider than 800px): two groups, as in the design prototype
const WORKSPACE = [
  { key: "home", href: base, label: "Home", icon: "home" },
  { key: "courses", href: `${base}courses/`, label: "Courses", icon: "courses", count: String(courseCount) },
  { key: "lessons", href: `${base}lessons/`, label: "Lessons", icon: "lessons" },
  { key: "videos", href: `${base}videos/`, label: "Videos", icon: "video" },
  { key: "podcasts", href: `${base}podcasts/`, label: "Podcasts", icon: "podcast" },
  // offline audio lives in the app
  ...(APP_BUILD ? [DOWNLOADS] : []),
] as const;
const TOOLS = [
  { key: "revise", href: `${base}revise/`, label: "Revision", icon: "edit" },
  { key: "mystudy", href: `${base}my-study/`, label: "My Study", icon: "bookmark", bookmarks: true },
  { key: "search", href: `${base}search/`, label: "Search", icon: "search" },
  { key: "preferences", href: `${base}preferences/`, label: "Preferences", icon: "user" },
] as const;
// bottom tab bar on phones and small tablets; the app swaps Videos (needs the internet) for Review (works offline)
const BOTTOM = [
  { key: "home", href: base, label: "Home", icon: "home" },
  { key: "courses", href: `${base}courses/`, label: "Courses", icon: "courses" },
  APP_BUILD ? ({ key: "revise", href: `${base}revise/`, label: "Review", icon: "edit" } as const) : ({ key: "videos", href: `${base}videos/`, label: "Videos", icon: "video" } as const),
  { key: "podcasts", href: `${base}podcasts/`, label: "Audio", icon: "podcast" },
  { key: "mystudy", href: `${base}my-study/`, label: "My Study", icon: "bookmark" },
] as const;
const current = nav === "notes" ? "lessons" : nav === "downloads" && !APP_BUILD ? "podcasts" : nav;
const CRUMB: Record<NavKey, string> = {
  home: "Home", courses: "Courses", lessons: "Lessons", notes: "Notes", videos: "Videos", podcasts: "Podcasts",
  revise: "Revision", mystudy: "My Study", search: "Search", preferences: "Preferences", about: "About & help", downloads: "Downloads",
};
const crumb = nav ? CRUMB[nav] : title;
---
<!doctype html>
<html lang="en" data-base={base} data-app={APP_BUILD ? "android" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1723" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/icon-192.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Mule Learning Hub" />
    <script is:inline>
      // Apply saved reading preferences before first paint (also re-run after each client-side navigation).
      (function () {
        function apply(doc) {
          var p = {};
          try { p = JSON.parse(localStorage.getItem("mls.prefs") || "{}") || {}; } catch (e) {}
          var dark = p.theme ? p.theme === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          var r = doc.documentElement;
          r.dataset.theme = dark ? "dark" : "light";
          r.dataset.width = p.width === "wide" ? "wide" : "normal";
          if (p.scale) r.style.setProperty("--read-scale", String(p.scale));
        }
        apply(document);
        document.addEventListener("astro:before-swap", function (e) { apply(e.newDocument); });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <aside class="sidebar" aria-label="Site">
      <a class="brand" href={base} aria-label="Mule Learning Hub home">
        <span class="brand__mark" aria-hidden="true">M</span>
        <span class="brand__text"><strong>Mule Learning Hub</strong><small>Learn. Build. Master.</small></span>
      </a>
      <nav class="side-nav" aria-label="Main">
        <p class="side-nav__label" aria-hidden="true">Workspace</p>
        <ul>
          {WORKSPACE.map((n) => (
            <li><a href={n.href} data-nav={n.key} aria-current={current === n.key ? "page" : undefined}><Icon name={n.icon} /><span>{n.label}</span>{"count" in n && <span class="side-nav__count" aria-hidden="true">{n.count}</span>}</a></li>
          ))}
        </ul>
        <p class="side-nav__label" aria-hidden="true">Study tools</p>
        <ul>
          {TOOLS.map((n) => (
            <li><a href={n.href} data-nav={n.key} aria-current={current === n.key ? "page" : undefined}><Icon name={n.icon} /><span>{n.label}</span>{"bookmarks" in n && <span class="side-nav__count" data-bookmark-count hidden aria-hidden="true"></span>}{n.key === "revise" && <span class="side-nav__count side-nav__count--due" data-due-count hidden title="Flashcards due for review"></span>}</a></li>
          ))}
        </ul>
      </nav>
      <div class="side-profile">
        <span class="side-profile__avatar" aria-hidden="true">ML</span>
        <span>My learning space<small>Progress saved in this browser</small></span>
      </div>
    </aside>

    <div class="app-main">
      <header class="topbar">
        <a class="topbar__mark brand__mark" href={base} aria-label="Mule Learning Hub home">M</a>
        <p class="topbar__crumb"><span>Workspace /</span> <b>{crumb}</b></p>
        <form class="topbar__search" role="search" aria-label="Search the site" action={`${base}search/`} method="get">
          <label class="visually-hidden" for="global-search">Search lessons, topics and notes</label>
          <Icon name="search" />
          <input id="global-search" type="search" name="q" placeholder="Search lessons, topics, notes…" autocomplete="off" data-global-search />
        </form>
        <div class="header-actions">
          <a class="icon-btn icon-btn--boxed hide-phone" href={`${base}revise/`} aria-label="Revision: glossary and flashcards" title="Revision"><Icon name="edit" /></a>
          <button class="icon-btn icon-btn--boxed theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Light / dark theme">
            <Icon name="sun" class="sun" /><Icon name="moon" class="moon" />
          </button>
          <a class="icon-btn icon-btn--boxed" href={`${base}my-study/`} aria-label="My study: bookmarks and progress" title="My study (saved in this browser)" aria-current={nav === "mystudy" ? "page" : undefined}><Icon name="user" /></a>
        </div>
      </header>

      <div class="offline-banner" data-offline-banner role="status" hidden>
        You're offline. Pages you've opened before still work; search, audio and video need a connection.
      </div>
      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <span>Personal study site. Progress is saved in this browser only.</span>
        <span>
          <a href={`${base}about/`}>About &amp; help</a> ·
          <a href={`${base}preferences/`}>Preferences</a> ·
          Notes from <a href="https://github.com/developerashok99/green-c-mule-notes" rel="noopener">green-c-mule-notes</a>{manifest.commit && <> @ <code>{manifest.commit.slice(0, 7)}</code></>}
        </span>
      </footer>
    </div>

    <nav class="bottom-nav" aria-label="Main">
      {BOTTOM.map((n) => <a href={n.href} aria-current={current === n.key ? "page" : undefined}><Icon name={n.icon} />{n.label}</a>)}
    </nav>

    <AudioPlayer />
    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>

    <script>
      import "../client/app";
    </script>
  </body>
</html>
