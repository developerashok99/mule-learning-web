---
import { ClientRouter } from "astro:transitions";
import Icon from "../components/Icon.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import { getManifest } from "../lib/content";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Which primary nav item is current */
  nav?: "home" | "courses" | "lessons" | "notes" | "podcasts" | "search" | "about" | "revise" | "mystudy";
}
const { title, description = "Personal MuleSoft study platform: lectures, summary podcasts and notes.", nav } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pageTitle = title === "Home" ? "Mule Study" : `${title} · Mule Study`;
const manifest = getManifest();
const NAV = [
  { key: "home", href: base, label: "Home", icon: "home" },
  { key: "courses", href: `${base}courses/`, label: "Courses", icon: "courses" },
  { key: "lessons", href: `${base}lessons/`, label: "Lessons", icon: "lessons" },
  { key: "notes", href: `${base}notes/`, label: "Notes", icon: "notes" },
  { key: "podcasts", href: `${base}podcasts/`, label: "Podcasts", icon: "podcast" },
] as const;
---
<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#20242c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/icon-192.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Mule Study" />
    <script is:inline>
      // Apply saved reading preferences before first paint (also re-run after each client-side navigation).
      (function () {
        function apply(doc) {
          var p = {};
          try { p = JSON.parse(localStorage.getItem("mls.prefs") || "{}") || {}; } catch (e) {}
          var dark = p.theme ? p.theme === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          var r = doc.documentElement;
          r.dataset.theme = dark ? "dark" : "light";
          r.dataset.width = p.width === "wide" ? "wide" : "normal";
          if (p.scale) r.style.setProperty("--read-scale", String(p.scale));
          r.dataset.lessonnav = p.lessonNav === "hidden" ? "hidden" : "shown";
        }
        apply(document);
        document.addEventListener("astro:before-swap", function (e) { apply(e.newDocument); });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={base} aria-label="Mule Study home">
          <span class="brand__mark" aria-hidden="true"><Icon name="courses" /></span>
          <span>Mule Study</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          {NAV.map((n) => <a href={n.href} aria-current={nav === n.key ? "page" : undefined}><Icon name={n.icon} />{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="search-trigger" href={`${base}search/`} aria-label="Search notes and lessons"><Icon name="search" /><span class="st-text">Search notes…</span><kbd>/</kbd></a>
          <a class="icon-btn only-phone" href={`${base}search/`} aria-label="Search"><Icon name="search" /></a>
          <a class="icon-btn" href={`${base}revise/`} aria-label="Revision: glossary and self-tests" title="Revision" aria-current={nav === "revise" ? "page" : undefined}><Icon name="check" /></a>
          <a class="icon-btn" href={`${base}my-study/`} aria-label="My study: bookmarks and progress" title="My study" aria-current={nav === "mystudy" ? "page" : undefined}><Icon name="bookmark" /></a>
          <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
            <Icon name="sun" class="sun" /><Icon name="moon" class="moon" />
          </button>
        </div>
      </div>
    </header>

    <div class="offline-banner" data-offline-banner role="status" hidden>
      You're offline. Pages you've opened before still work; search, audio and video need a connection.
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Personal study site. Progress is saved in this browser only.</span>
        <span>
          <a href={`${base}about/`}>About &amp; help</a> ·
          Notes from <a href="https://github.com/developerashok99/green-c-mule-notes" rel="noopener">green-c-mule-notes</a>{manifest.commit && <> @ <code>{manifest.commit.slice(0, 7)}</code></>}
        </span>
      </div>
    </footer>

    <nav class="bottom-nav" aria-label="Main">
      {NAV.map((n) => <a href={n.href} aria-current={nav === n.key ? "page" : undefined}><Icon name={n.icon} />{n.label}</a>)}
    </nav>

    <AudioPlayer />
    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>

    <script>
      import "../client/app";
    </script>
  </body>
</html>
