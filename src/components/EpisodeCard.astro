---
/**
 * One summary podcast episode: what it covers, and its two formats side by side — Watch video (opens the episode)
 * and Play audio (the site-wide audio player). The whole card opens the episode page.
 */
import Icon from "./Icon.astro";
import type { Episode } from "../lib/config";
import { getLesson } from "../lib/content";
import { formatLength } from "../lib/duration";
import { podcastPath, withBase } from "../lib/routes";

interface Props {
  episode: Episode;
  /** already on this episode's page: no link to it */
  compact?: boolean;
}
const { episode: ep, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const lessons = ep.lessons.map((id) => getLesson(id)!).filter(Boolean);
const sections = [...new Set(lessons.map((l) => l.sectionId))].join(" ");
const available = !!(ep.audioUrl || ep.videoUrl);
const kinds = [ep.audioUrl && "audio", ep.videoUrl && "video"].filter(Boolean).join(" ");
const href = withBase(base, podcastPath(ep.id));
// "Day 5" → "D5", "Interview Part 1" → "IP1"
const abbr = ep.test ? "T" : (lessons[0]?.label ?? ep.title).split(/\s+/).map((w) => (/^\d+$/.test(w) ? w : w[0])).join("").toUpperCase().slice(0, 4);
---
<li class:list={["episode", { "episode--link": !compact }]} data-filter-item={`${ep.title} ${ep.description} ${lessons.map((l) => `${l.label} ${l.title}`).join(" ")}`} data-sections={sections} data-available={String(available)} data-kinds={kinds}>
  <span class="epicon" aria-hidden="true">{abbr}</span>
  <div class="episode__body">
    <h3 class="episode__title">{compact ? ep.title : <a href={href}>{ep.title}</a>}</h3>
    <div class="episode__meta">
      {ep.duration != null && <span><Icon name="clock" /> {formatLength(ep.duration)}</span>}
      {/* plain text: the whole card opens the episode, whose page links to each lesson */}
      {lessons.length > 0 && <span>Covers {lessons.map((l) => l.label).join(", ")}</span>}
      {ep.test && <span class="pill pill--amber">Test media</span>}
      {ep.demo && <span class="pill pill--amber">Demo</span>}
    </div>
    {ep.description && <p class="episode__desc">{ep.description}</p>}
    <div class="progress progress--thin" data-episode-progress={ep.id} hidden role="img" aria-label="0% listened"><span></span></div>
    <div class="episode__actions">
      {!compact && ep.videoUrl && <a class="btn btn--sm" href={`${href}#video`}><Icon name="video" /> Watch video</a>}
      {ep.audioUrl
        ? <button class="btn btn--sm audio-btn" type="button" data-play-episode={ep.id} data-label={ep.title} aria-label={`Play audio: ${ep.title}`}><Icon name="play" class="play" /><Icon name="pause" class="pause" /><span class="play">Play audio</span><span class="pause">Pause</span></button>
        : <button class="btn btn--sm" type="button" disabled aria-label={`Audio not available yet: ${ep.title}`}><Icon name="podcast" /> No audio yet</button>}
      {!available && <span class="small muted">Not added yet</span>}
    </div>
    {ep.audioUrl && !ep.test && <div class="dl-slot app-only" data-download={ep.id}></div>}
  </div>
</li>
