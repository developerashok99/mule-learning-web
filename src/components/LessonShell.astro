---
/**
 * Shared frame for every lesson view: breadcrumb, title, bookmark / complete / all lessons, the resource tabs,
 * and previous / next lesson. The "All lessons" drawer lists every lesson with its status.
 */
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import LessonNav from "./LessonNav.astro";
import { getCourses, getLesson, type Lesson } from "../lib/content";
import { formatLength } from "../lib/duration";
import { lessonHasView, lessonPath, withBase, type View } from "../lib/routes";

interface Props {
  lesson: Lesson;
  view: View;
  /** Page title prefix, e.g. "Detailed notes" */
  viewLabel: string;
}
const { lesson, view, viewLabel } = Astro.props;
// Notes, slides and revision views have their own main heading, so the lesson title is not an h1 there.
const compact = view !== "lecture" && view !== "podcast";
const base = import.meta.env.BASE_URL;
const u = (v: View, id = lesson.id) => withBase(base, lessonPath(id, v));
const course = getCourses().find((c) => c.id === lesson.courseId)!;
type Tab = { label: string; why: string } & ({ view: View } | { href: string | null });
const tabs: Tab[] = [
  { view: "lecture", label: "Overview", why: "" },
  { view: "simple", label: "Simple notes", why: "No simple notes for this lesson" },
  { view: "detailed", label: "Detailed notes", why: "No detailed notes for this lesson" },
  { view: "super", label: "Super-detailed", why: "No super-detailed notes for this lesson" },
  { view: "slides", label: `Slides${lesson.slides ? ` (${lesson.slides})` : ""}`, why: "No slides for this lesson" },
  { href: lesson.lecture?.youtubeId ? withBase(base, `videos/${lesson.id}/`) : null, label: "Video", why: "No lecture video has been added for this lesson yet" },
  { view: "podcast", label: "Podcast", why: "No summary podcast has been added for this lesson yet" },
  { view: "revise", label: "Revision", why: "No notes to revise from" },
];
const prev = lesson.prev ? getLesson(lesson.prev) : null;
const next = lesson.next ? getLesson(lesson.next) : null;
// Keep the same tab when moving between lessons, if the other lesson has it.
const navHref = (l: Lesson) => u(lessonHasView(l, view) ? view : "lecture", l.id);
const sub = [
  lesson.sectionTitle,
  lesson.lecture?.duration != null ? `${formatLength(lesson.lecture.duration)} lecture` : "",
  lesson.slides > 0 ? `${lesson.slides} slides` : "",
].filter(Boolean).join(" · ");
---
<Base title={`${viewLabel} · ${lesson.label}: ${lesson.title}`} description={`${lesson.label} — ${lesson.title}`} nav="lessons">
  <div class="lesson-page" data-lesson-page={lesson.id} data-view={view} data-title={`${lesson.label} — ${lesson.title}`}>
    <ol class="breadcrumb">
      <li><a href={withBase(base, "courses/")}>Courses</a></li>
      <li><a href={withBase(base, `courses/${course.id}/`)}>{course.title}</a></li>
      <li><a href={withBase(base, `courses/${course.id}/#${lesson.sectionId}`)}>{lesson.sectionTitle}</a></li>
    </ol>
    <div class="head lesson-head">
      <div class="head__text">
        <p class="eyebrow">{course.title} / {lesson.label}</p>
        {compact ? <p class="lesson-head__title">{lesson.title}</p> : <h1 class="lesson-head__title">{lesson.title}</h1>}
        <p class="sub">{sub}</p>
      </div>
      <div class="head__actions lesson-actions">
        <button class="btn" type="button" data-open-jump aria-haspopup="dialog" aria-controls="lesson-drawer"><Icon name="list" /><span>All lessons</span></button>
        <button class="btn" type="button" data-toggle-bookmark aria-pressed="false"><Icon name="bookmark" /><span data-text>Bookmark</span></button>
        <button class="btn btn--primary" type="button" data-toggle-done aria-pressed="false"><Icon name="check" /><span data-text>Mark complete</span></button>
      </div>
    </div>

    <nav class="lesson-tabs" aria-label="Lesson resources">
      {tabs.map((t) => {
        const href = "view" in t ? (lessonHasView(lesson, t.view) ? u(t.view) : null) : t.href;
        const current = "view" in t && t.view === view;
        return href
          ? <a href={href} aria-current={current ? "page" : undefined}>{t.label}</a>
          : <span aria-disabled="true" title={t.why}>{t.label}<span class="visually-hidden"> (not available: {t.why})</span></span>;
      })}
    </nav>

    <slot />

    <nav class="lesson-pager" aria-label="Previous and next lesson">
      {prev
        ? <a class="nav-card" href={navHref(prev)} rel="prev"><Icon name="left" /><span class="nav-card__text"><small>Previous lesson</small><strong>{prev.label} · {prev.title}</strong></span></a>
        : <span class="nav-card" aria-disabled="true"><Icon name="left" /><span class="nav-card__text"><small>Previous lesson</small><strong>This is the first lesson</strong></span></span>}
      {next
        ? <a class="nav-card nav-card--next" href={navHref(next)} rel="next"><span class="nav-card__text"><small>Next lesson</small><strong>{next.label} · {next.title}</strong></span><Icon name="right" /></a>
        : <span class="nav-card nav-card--next" aria-disabled="true"><span class="nav-card__text"><small>Next lesson</small><strong>This is the last lesson</strong></span><Icon name="right" /></span>}
    </nav>
  </div>

  <dialog class="jump-dialog" id="lesson-drawer" data-jump-dialog aria-label="Jump to a lesson" data-filter-scope>
    <header>
      <label class="visually-hidden" for="jump-filter">Filter lessons</label>
      <input id="jump-filter" class="input" type="search" placeholder="Filter lessons…" autocomplete="off" data-filter-text />
      <button class="icon-btn" type="button" data-close aria-label="Close"><Icon name="close" /></button>
    </header>
    <nav class="jump-dialog__body" aria-label="All lessons">
      <LessonNav lesson={lesson} view={view} idPrefix="drawer" />
      <p class="empty" data-filter-empty hidden>No lessons match.</p>
    </nav>
  </dialog>
</Base>
