---
/**
 * Shared frame for every lesson view: lesson sidebar (wide screens) / drawer (smaller screens), breadcrumb,
 * title, complete/bookmark, resource tabs, previous/next lesson.
 */
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import LessonNav from "./LessonNav.astro";
import { getCourses, getLesson, type Lesson } from "../lib/content";
import { lessonHasView, lessonPath, withBase, type View } from "../lib/routes";

interface Props {
  lesson: Lesson;
  view: View;
  /** Page title prefix, e.g. "Detailed notes" */
  viewLabel: string;
}
const { lesson, view, viewLabel } = Astro.props;
const compact = view !== "lecture" && view !== "podcast";
const base = import.meta.env.BASE_URL;
const u = (v: View, id = lesson.id) => withBase(base, lessonPath(id, v));
const course = getCourses().find((c) => c.id === lesson.courseId)!;
type IconName = "lecture" | "podcast" | "text" | "notes" | "file" | "slides" | "check";
const tabs: { view: View; label: string; icon: IconName; why: string }[] = [
  { view: "lecture", label: "Overview", icon: "lecture", why: "" },
  { view: "podcast", label: "Podcast", icon: "podcast", why: "No summary podcast has been added for this lesson yet" },
  { view: "simple", label: "Simple", icon: "text", why: "No simple notes for this lesson" },
  { view: "detailed", label: "Detailed", icon: "notes", why: "No detailed notes for this lesson" },
  { view: "super", label: "Super-detailed", icon: "file", why: "No super-detailed notes for this lesson" },
  { view: "slides", label: `Slides${lesson.slides ? ` (${lesson.slides})` : ""}`, icon: "slides", why: "No slides for this lesson" },
  { view: "revise", label: "Revise", icon: "check", why: "No notes to revise from" },
];
const prev = lesson.prev ? getLesson(lesson.prev) : null;
const next = lesson.next ? getLesson(lesson.next) : null;
// Keep the same tab when moving between lessons, if the other lesson has it.
const navHref = (l: Lesson) => u(lessonHasView(l, view) ? view : "lecture", l.id);
---
<Base title={`${viewLabel} · ${lesson.label}: ${lesson.title}`} description={`${lesson.label} — ${lesson.title}`} nav="lessons">
  <div class="lesson-layout" data-lesson-page={lesson.id} data-view={view} data-title={`${lesson.label} — ${lesson.title}`}>
    <aside class="lesson-sidebar" aria-label="Course lessons">
      <div class="lesson-sidebar__head">
        <a href={withBase(base, `courses/${course.id}/`)} class="small"><b>{course.title}</b></a>
      </div>
      <nav aria-label="Lessons in this course">
        <LessonNav lesson={lesson} view={view} idPrefix="side" />
      </nav>
    </aside>

    <div class="lesson-main">
      <ol class="breadcrumb">
        <li><a href={withBase(base, "courses/")}>Courses</a></li>
        <li><a href={withBase(base, `courses/${course.id}/`)}>{course.title}</a></li>
        <li><a href={withBase(base, `courses/${course.id}/#${lesson.sectionId}`)}>{lesson.sectionTitle}</a></li>
      </ol>
      <div class:list={["lesson-head", { "lesson-head--compact": compact }]}>
        <div>
          <p class="eyebrow">{lesson.label}{compact && <> · {lesson.title}</>}</p>
          {/* Notes, slides and revision views have their own main heading, so the lesson title is not repeated as h1 there. */}
          {!compact && <h1>{lesson.title}</h1>}
        </div>
        <div class="btn-row">
          <button class="btn btn--sm" type="button" data-toggle-done aria-pressed="false"><Icon name="check" /><span data-text class="label-collapse">Mark complete</span></button>
          <button class="btn btn--sm" type="button" data-toggle-bookmark aria-pressed="false"><Icon name="bookmark" /><span data-text class="label-collapse">Bookmark</span></button>
          <button class="btn btn--sm" type="button" data-open-jump aria-haspopup="dialog" aria-controls="lesson-drawer"><Icon name="list" /><span class="label-collapse">Lessons</span></button>
        </div>
      </div>

      <nav class="lesson-tabs" aria-label="Lesson resources">
        {tabs.map((t, i) => (
          <>
            {(i === 2 || i === 6) && <span class="tab-group-sep" aria-hidden="true" />}
            {lessonHasView(lesson, t.view)
              ? <a href={u(t.view)} aria-current={t.view === view ? "page" : undefined}><Icon name={t.icon} />{t.label}</a>
              : <span aria-disabled="true" title={t.why}><Icon name={t.icon} />{t.label}<span class="visually-hidden"> (not available: {t.why})</span></span>}
          </>
        ))}
      </nav>

      <slot />

      <nav class="pager" aria-label="Previous and next lesson">
        {prev && <a class="prev" href={navHref(prev)} rel="prev"><small>← Previous lesson</small><span>{prev.label} — {prev.title}</span></a>}
        {next && <a class="next" href={navHref(next)} rel="next"><small>Next lesson →</small><span>{next.label} — {next.title}</span></a>}
      </nav>
    </div>
  </div>

  <dialog class="jump-dialog" id="lesson-drawer" data-jump-dialog aria-label="Jump to a lesson" data-filter-scope>
    <header>
      <label class="visually-hidden" for="jump-filter">Filter lessons</label>
      <input id="jump-filter" class="input" type="search" placeholder="Filter lessons…" autocomplete="off" data-filter-text />
      <button class="icon-btn" type="button" data-close aria-label="Close"><Icon name="close" /></button>
    </header>
    <nav class="jump-dialog__body" aria-label="All lessons">
      <LessonNav lesson={lesson} view={view} idPrefix="drawer" />
      <p class="empty" data-filter-empty hidden>No lessons match.</p>
    </nav>
  </dialog>
</Base>
