---
/**
 * Videos tab ("Lecture library"): one lecture at the top, its title, study actions and previous / next under it,
 * and every course video in order (Day 1 → the interview parts) as a filterable playlist beside it (below it on phones).
 */
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import PageHead from "./PageHead.astro";
import { getCourses, getLessons, type Lesson } from "../lib/content";
import { formatLength } from "../lib/duration";
import { lessonHasView, lessonPath, withBase } from "../lib/routes";

interface Props {
  /** the video being watched */
  current: Lesson;
  /** /videos/ itself: offers "continue where you left off" (filled in by the browser) */
  isIndex?: boolean;
}
const { current, isIndex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const course = getCourses().find((c) => c.id === current.courseId)!;
const videos = getLessons().filter((l) => l.lecture?.youtubeId);
const at = videos.findIndex((l) => l.id === current.id);
const prev = at > 0 ? videos[at - 1] : null;
const next = at < videos.length - 1 ? videos[at + 1] : null;
const href = (l: Lesson) => withBase(base, `videos/${l.id}/`);
const sections = getCourses()
  .flatMap((c) => c.sections)
  .map((s) => ({ ...s, videos: videos.filter((l) => s.lessons.includes(l.id)) }))
  .filter((s) => s.videos.length);
const lecture = current.lecture!;
const name = `${current.label} — ${current.title}`;
const notesHref = withBase(base, lessonPath(current.id, lessonHasView(current, "detailed") ? "detailed" : "lecture"));
---
<Base title={`${current.label} video`} nav="videos" description={`Watch ${name}, then go to the next or previous course video.`}>
  <div class="page" data-video-page={current.id}>
    <PageHead eyebrow="Watch and learn" title="Lecture library" sub="Study with the lecture, follow the playlist, and mark progress without losing your place.">
      <Fragment slot="actions">
        <span class="pill pill--green">● Course playlist</span>
        <a class="btn" href={notesHref}>Open lesson notes</a>
      </Fragment>
    </PageHead>
    {isIndex && (
      <p class="notice video-resume" data-video-resume hidden>
        <Icon name="play" /><span>Continue where you left off: <a data-video-go="pick" href=""></a></span>
      </p>
    )}
    <div class="video-layout">
      <div class="video-main">
        <div class="media-frame video-frame">
          <button class="yt-facade" type="button" data-yt={lecture.youtubeId} data-start={lecture.start} data-watch={lecture.watchUrl} data-title={`Lecture: ${name}`} aria-label={`Play video: ${name}`}>
            <span class="yt-facade__kicker">{course.title} · {current.label}</span>
            <span class="yt-facade__title">{current.title}</span>
            <span class="yt-facade__play"><Icon name="play" /></span>
            <small>Click to play · loads from youtube-nocookie.com</small>
          </button>
        </div>

        <div class="video-info">
          <div class="video-info__text">
            <span class="pill pill--blue">{current.label}</span>
            <h2>{current.title}</h2>
            <p class="small muted">{current.sectionTitle}{lecture.duration != null && <> · {formatLength(lecture.duration)}</>}</p>
          </div>
          <div class="video-actions">
            <button class="btn btn--sm" type="button" data-video-done aria-pressed="false"><Icon name="check" /><span data-text>Mark complete</span></button>
            <button class="btn btn--sm" type="button" data-video-bookmark aria-pressed="false"><Icon name="bookmark" /><span data-text>Bookmark</span></button>
          </div>
        </div>

        <nav class="video-pager" aria-label="Previous and next video">
          {prev ? (
            <a class="nav-card" href={href(prev)} data-video-go="prev" rel="prev"><Icon name="left" /><span class="nav-card__text"><small>Previous lesson</small><strong>{prev.label} · {prev.title}</strong></span></a>
          ) : (
            <span class="nav-card" aria-disabled="true"><Icon name="left" /><span class="nav-card__text"><small>Previous</small><strong>This is the first video</strong></span></span>
          )}
          {next ? (
            <a class="nav-card nav-card--next" href={href(next)} data-video-go="next" rel="next"><span class="nav-card__text"><small>Next lesson</small><strong>{next.label} · {next.title}</strong></span><Icon name="right" /></a>
          ) : (
            <span class="nav-card nav-card--next" aria-disabled="true"><span class="nav-card__text"><small>Next</small><strong>This is the last video</strong></span><Icon name="right" /></span>
          )}
        </nav>

        <div class="section-head"><div><h2>About this lecture</h2><p>Pair video learning with written notes</p></div></div>
        <section class="card video-about" aria-label="About this lecture">
          <h3 style="margin:0 0 .3rem;font-size:.98rem">Read the lesson notes</h3>
          <p class="small muted">Review key ideas, examples and deeper explanations at your own pace.</p>
          <div class="video-meta">
            {lecture.duration != null && <span class="video-meta__item"><Icon name="clock" /> {formatLength(lecture.duration)}</span>}
            <a class="video-meta__item" href={withBase(base, lessonPath(current.id))}><Icon name="notes" /> Lesson page</a>
            {lecture.watchUrl && <a class="video-meta__item" href={lecture.watchUrl} target="_blank" rel="noopener noreferrer"><Icon name="external" /> Open on YouTube</a>}
            <label class="switch"><input type="checkbox" role="switch" data-video-autoplay checked /> Play next automatically</label>
          </div>
          <p class="video-keys">Keyboard: <kbd>Shift</kbd> + <kbd>P</kbd> previous · <kbd>Shift</kbd> + <kbd>N</kbd> next</p>
          <div class="btn-row">
            <a class="btn btn--primary btn--sm" href={notesHref}>Open lesson notes →</a>
          </div>
        </section>
      </div>

      <aside class="card playlist" aria-label="Course playlist">
        <nav class="video-list" aria-label="All course videos" data-filter-scope>
          <div class="playlist__head">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem">
              <div><h2>Course playlist</h2><span class="small">{course.title} · {videos.length} lessons</span></div>
              <span class="pill">Video {at + 1} / {videos.length}</span>
            </div>
            <label class="visually-hidden" for="video-filter">Filter videos</label>
            <input id="video-filter" class="input input--sm" type="search" placeholder="Filter lessons…" autocomplete="off" data-filter-text />
            <span class="visually-hidden" data-filter-count aria-live="polite"></span>
          </div>
          <div class="video-list__scroll" data-video-list>
            {sections.map((s) => (
              <section data-filter-group>
                <h3 class="video-list__section">{s.title}</h3>
                <ol>
                  {s.videos.map((l) => (
                    <li data-lesson-done={l.id} data-filter-item={`${l.label} ${l.title}`}>
                      <a href={href(l)} data-video-go="pick" aria-current={l.id === current.id ? "page" : undefined}>
                        <span class="pnum" aria-hidden="true">{String(videos.indexOf(l) + 1).padStart(2, "0")}</span>
                        <span class="video-list__text"><strong>{l.label} · {l.title}</strong><small>{s.title}{l.lecture?.duration != null && <> · {formatLength(l.lecture.duration)}</>}</small></span>
                        <span class="video-list__mark" aria-hidden="true"><span class="m-new">○</span><Icon name="check" class="m-done" /><Icon name="play" class="m-play" /></span>
                        <span class="visually-hidden" data-status-label>Not started</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
            <p class="video-list__empty" data-filter-empty hidden>No videos match.</p>
          </div>
        </nav>
        <div class="playlist__foot">
          <span class="small muted">Every lesson with notes</span>
          <a class="btn btn--sm" href={withBase(base, `courses/${course.id}/`)}>All lessons →</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
