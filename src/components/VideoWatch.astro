---
/**
 * Videos tab: one lecture video at the top, its title and Previous / Next under it, and every course video
 * in order (Day 1 → the interview parts) as a filterable playlist beside it (below it on phones).
 */
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { getCourses, getLessons, type Lesson } from "../lib/content";
import { formatLength } from "../lib/duration";
import { lessonPath, withBase } from "../lib/routes";

interface Props {
  /** the video being watched */
  current: Lesson;
  /** /videos/ itself: offers "continue where you left off" (filled in by the browser) */
  isIndex?: boolean;
}
const { current, isIndex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const videos = getLessons().filter((l) => l.lecture?.youtubeId);
const at = videos.findIndex((l) => l.id === current.id);
const prev = at > 0 ? videos[at - 1] : null;
const next = at < videos.length - 1 ? videos[at + 1] : null;
const href = (l: Lesson) => withBase(base, `videos/${l.id}/`);
const sections = getCourses()
  .flatMap((c) => c.sections)
  .map((s) => ({ ...s, videos: videos.filter((l) => s.lessons.includes(l.id)) }))
  .filter((s) => s.videos.length);
const lecture = current.lecture!;
const name = `${current.label} — ${current.title}`;
---
<Base title={`${current.label} video`} nav="videos" description={`Watch ${name}, then go to the next or previous course video.`}>
  <div class="container video-page" data-video-page={current.id}>
    {isIndex && (
      <p class="notice video-resume" data-video-resume hidden>
        <Icon name="play" /><span>Continue where you left off: <a data-video-go="pick" href=""></a></span>
      </p>
    )}
    <div class="video-layout">
      <div class="video-main">
        <div class="media-frame video-frame">
          <button class="yt-facade" type="button" data-yt={lecture.youtubeId} data-start={lecture.start} data-watch={lecture.watchUrl} data-title={`Lecture: ${name}`} aria-label={`Play video: ${name}`}>
            <span class="yt-facade__play"><Icon name="play" /></span>
            <span class="yt-facade__title">{current.label} · {current.title}</span>
            <small>Plays from youtube-nocookie.com when you press play</small>
          </button>
        </div>

        <div class="video-info">
          <p class="video-kicker"><span>{current.label}</span><span aria-hidden="true">·</span><span>{current.sectionTitle}</span></p>
          <h1 class="video-title">{current.title}</h1>

          <div class="video-pager" aria-label="Previous and next video" role="group">
            {prev ? (
              <a class="btn" href={href(prev)} data-video-go="prev" rel="prev"><Icon name="left" /><span>Previous<span class="video-pager__name"> · {prev.label}</span></span></a>
            ) : (
              <span class="btn" aria-disabled="true"><Icon name="left" /><span>Previous</span></span>
            )}
            <span class="video-pager__count"><b>{at + 1}</b> of {videos.length}</span>
            {next ? (
              <a class="btn btn--primary" href={href(next)} data-video-go="next" rel="next"><span>Next<span class="video-pager__name"> · {next.label}</span></span><Icon name="right" /></a>
            ) : (
              <span class="btn btn--primary" aria-disabled="true"><span>Next</span><Icon name="right" /></span>
            )}
          </div>

          <div class="video-actions">
            <button class="btn btn--sm" type="button" data-video-done aria-pressed="false"><Icon name="check" /><span data-text>Mark lesson complete</span></button>
            <button class="btn btn--sm" type="button" data-video-bookmark aria-pressed="false"><Icon name="bookmark" /><span data-text>Bookmark</span></button>
          </div>
          <div class="video-meta">
            {lecture.duration != null && <span class="video-meta__item"><Icon name="clock" /> {formatLength(lecture.duration)}</span>}
            <a class="video-meta__item" href={withBase(base, lessonPath(current.id))}><Icon name="notes" /> Lesson page &amp; notes</a>
            {lecture.watchUrl && <a class="video-meta__item" href={lecture.watchUrl} target="_blank" rel="noopener noreferrer"><Icon name="external" /> Open on YouTube</a>}
            <label class="switch video-meta__auto"><input type="checkbox" role="switch" data-video-autoplay checked /> Play next automatically</label>
          </div>
          <p class="video-keys">Keyboard: <kbd>Shift</kbd> + <kbd>P</kbd> previous · <kbd>Shift</kbd> + <kbd>N</kbd> next</p>

          {next && (
            <a class="video-upnext" href={href(next)} data-video-go="pick">
              <span class="video-upnext__icon" aria-hidden="true"><Icon name="play" /></span>
              <span class="video-upnext__text"><small>Up next</small><span><b>{next.label}</b> {next.title}</span></span>
              {next.lecture?.duration != null && <span class="video-upnext__len">{formatLength(next.lecture.duration)}</span>}
            </a>
          )}
        </div>
      </div>

      <nav class="video-list" aria-label="All course videos" data-filter-scope>
        <div class="video-list__head">
          <div class="video-list__heading"><strong>Course videos</strong><span data-filter-count>{videos.length} videos</span></div>
          <label class="visually-hidden" for="video-filter">Filter videos</label>
          <input id="video-filter" class="input input--sm" type="search" placeholder="Filter by day or topic" autocomplete="off" data-filter-text />
        </div>
        <div class="video-list__scroll" data-video-list>
          {sections.map((s) => (
            <section data-filter-group>
              <h2 class="video-list__section">{s.title}</h2>
              <ol>
                {s.videos.map((l) => (
                  <li data-lesson-done={l.id} data-filter-item={`${l.label} ${l.title}`}>
                    <a href={href(l)} data-video-go="pick" aria-current={l.id === current.id ? "page" : undefined}>
                      <span class="video-list__num" aria-hidden="true">{l.id === current.id ? <Icon name="play" /> : <><span class="n">{videos.indexOf(l) + 1}</span><Icon name="check" /></>}</span>
                      <span class="video-list__text"><b>{l.label}</b> {l.title}</span>
                      {l.lecture?.duration != null && <span class="video-list__len">{formatLength(l.lecture.duration)}</span>}
                      <span class="visually-hidden" data-status-label>Not started</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
          <p class="video-list__empty" data-filter-empty hidden>No videos match.</p>
        </div>
      </nav>
    </div>
  </div>
</Base>
