---
/** Shown on a watch page opened from a friend's watch-together link when joining failed: offers to try again. */
import Icon from "./Icon.astro";
---
<div class="notice together-invite" data-together-invite hidden>
  <Icon name="users" />
  <div><strong>Your friend's watch-together link</strong><p>Joining didn't work this time. Try again, or ask your friend for a new link.</p></div>
  <button class="btn btn--primary btn--sm" type="button" data-together-join><Icon name="play" /> Join and watch</button>
</div>
