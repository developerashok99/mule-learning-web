{
  "name": "mule-learning-web",
  "version": "1.0.0",
  "description": "Personal MuleSoft study platform: lectures, summary podcasts and notes in one place",
  "scripts": {
    "sync": "node scripts/sync-notes.mjs",
    "dev": "npm run sync && astro dev",
    "build:site": "astro build && pagefind --site dist",
    "build": "npm run sync && npm run build:site",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run sync && npm run build:test && npm run test:links && npm run test:e2e && npm run build:site",
    "build:test": "SHOW_TEST_EPISODES=true npm run build:site",
    "build:app": "APP_BUILD=1 astro build && pagefind --site dist-app",
    "app:sync": "npm run build:app && npx cap sync android",
    "app:apk": "npm run app:sync && cd android && ./gradlew assembleDebug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerashok99/mule-learning-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/developerashok99/mule-learning-web/issues"
  },
  "homepage": "https://github.com/developerashok99/mule-learning-web#readme",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-media-session": "^8.1.5",
    "astro": "^7.3.8",
    "cytoscape": "^3.34.3",
    "github-slugger": "^2.0.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^12.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
